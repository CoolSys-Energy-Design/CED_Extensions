<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Tag by Example"
        Height="650"
        Width="440"
        MinHeight="520"
        MinWidth="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Closing="window_closing"
        PreviewKeyDown="window_preview_key_down"
        Focusable="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14">
      <TextBlock Text="Tag by Example" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
      <Button Name="PickExampleButton" Content="Pick New Reference(s)" Height="30" Click="pick_example_clicked"/>

      <TextBlock Name="SelectionInstructionsText" Visibility="Collapsed"
                 TextWrapping="Wrap" Margin="0,8,0,0" Foreground="DarkBlue"/>

      <GroupBox Header="Example" Margin="0,10,0,0">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Tag type:" FontWeight="Bold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Name="ExampleTypeText" Text="No example selected" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Text="Host category:" FontWeight="Bold"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Name="HostCategoryText" Text="-" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Text="Host family:" FontWeight="Bold"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Name="HostFamilyText" Text="-" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Text="Host type:" FontWeight="Bold"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Name="HostTypeText" Text="-" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Text="Owner view:" FontWeight="Bold"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Name="OwnerViewText" Text="-" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Text="References:" FontWeight="Bold"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Name="ReferenceCountText" Text="0" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Text="Leader / orientation:" FontWeight="Bold"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Name="LeaderText" Text="-" TextWrapping="Wrap"/>
        </Grid>
      </GroupBox>

      <GroupBox Header="Targets" Margin="0,10,0,0">
        <StackPanel Margin="8">
          <ComboBox Name="TargetModeCombo" SelectionChanged="target_mode_changed" SelectedIndex="0">
            <ComboBoxItem Tag="type" Content="All visible elements of the same type"/>
            <ComboBoxItem Tag="family" Content="All visible elements of the same family"/>
            <ComboBoxItem Tag="category" Content="All visible elements of the same category"/>
            <ComboBoxItem Tag="manual" Content="User selection"/>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Name="NewTargetsButton" Content="New" Width="62" Height="28" Margin="0,0,5,0" Click="new_targets_clicked" IsEnabled="False"/>
            <Button Name="EditTargetsButton" Content="Edit" Width="62" Height="28" Margin="0,0,5,0" Click="edit_targets_clicked" IsEnabled="False"/>
            <Button Name="PreviewSelectionButton" Content="Preview selection" Width="112" Height="28" Click="preview_selection_clicked" IsEnabled="False"/>
          </StackPanel>
          <CheckBox Name="IncludeNestedToggle" Content="Include nested family instances" Margin="0,7,0,0" Checked="option_changed" Unchecked="option_changed"/>
          <TextBlock Name="TargetCountText" Text="Targets: 0" Margin="0,6,0,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Placement" Margin="0,10,0,0">
        <StackPanel Margin="8">
          <CheckBox Name="PreserveRotationToggle" Content="Preserve tag rotation relative to the host" IsChecked="True" Checked="option_changed" Unchecked="option_changed"/>
          <CheckBox Name="UseModelOrientationToggle" Content="Use model orientation" IsChecked="True" Checked="option_changed" Unchecked="option_changed"/>
          <CheckBox Name="CopyLeaderToggle" Content="Copy leader" IsChecked="True" Checked="option_changed" Unchecked="option_changed"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Existing tags" Margin="0,10,0,0">
        <StackPanel Margin="8">
          <RadioButton Name="ReplaceAllRadio" Content="Replace all tags" GroupName="ExistingTags" IsChecked="False" Checked="option_changed"/>
          <RadioButton Name="ReplaceMatchingRadio" Content="Replace matching reference tag types only" GroupName="ExistingTags" Checked="option_changed"/>
          <RadioButton Name="SkipMatchingRadio" Content="Skip matching reference tag types" GroupName="ExistingTags" IsChecked="True" Checked="option_changed"/>
        </StackPanel>
      </GroupBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Name="CreateButton" Content="Create Tags" Width="88" Margin="0,0,5,0" Click="create_clicked" IsEnabled="False"/>
        <Button Name="CloseButton" Content="Close" Width="92" Click="close_clicked"/>
      </StackPanel>
      <TextBlock Name="StatusText" Text="Select an example tag to begin." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="DimGray"/>
    </StackPanel>
  </ScrollViewer>
</Window>
