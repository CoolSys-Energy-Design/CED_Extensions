<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag by Example"
        Height="730"
        Width="460"
        MinHeight="560"
        MinWidth="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource CED.Brush.WindowBackground}"
        Foreground="{DynamicResource CED.Brush.PrimaryText}"
        Closing="window_closing"
        PreviewKeyDown="window_preview_key_down"
        Focusable="True">
  <Window.Resources>
    <Style x:Key="TagByExample.Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="TagByExample.Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="{DynamicResource CED.Thickness.ContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Tag by Example" Style="{DynamicResource CED.Text.Title}"/>
      <TextBlock Name="TargetViewText"
                 Text="Target View: (none)"
                 HorizontalAlignment="Right"
                 Style="{DynamicResource CED.Text.Secondary}"
                 FontSize="11"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Border BorderBrush="{DynamicResource CED.Brush.ListBorder}"
              BorderThickness="1"
              Background="{DynamicResource CED.Brush.ListBackground}"
              CornerRadius="4">
      <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False"
                    Padding="10">
        <StackPanel>
          <Border Style="{StaticResource TagByExample.Card}" Margin="0,0,0,4">
            <StackPanel>
              <Button Name="PickExampleButton"
                      Content="Pick New Reference(s)"
                      Style="{DynamicResource CED.Button.Primary}"
                      Height="30"
                      HorizontalAlignment="Left"
                      Click="pick_example_clicked"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="128"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Tag type:" Style="{StaticResource TagByExample.Label}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Name="ExampleTypeText" Text="No example selected" TextWrapping="Wrap" Style="{DynamicResource CED.Text.Primary}"/>
                <TextBlock Grid.Row="1" Text="Host category:" Style="{StaticResource TagByExample.Label}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Name="HostCategoryText" Text="-" TextWrapping="Wrap" Style="{DynamicResource CED.Text.Primary}"/>
                <TextBlock Grid.Row="2" Text="Host family:" Style="{StaticResource TagByExample.Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Name="HostFamilyText" Text="-" TextWrapping="Wrap" Style="{DynamicResource CED.Text.Primary}"/>
                <TextBlock Grid.Row="3" Text="Host type:" Style="{StaticResource TagByExample.Label}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Name="HostTypeText" Text="-" TextWrapping="Wrap" Style="{DynamicResource CED.Text.Primary}"/>
                <TextBlock Grid.Row="4" Text="Owner view:" Style="{StaticResource TagByExample.Label}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Name="OwnerViewText" Text="-" TextWrapping="Wrap" Style="{DynamicResource CED.Text.Primary}"/>
                <TextBlock Grid.Row="5" Text="References:" Style="{StaticResource TagByExample.Label}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Name="ReferenceCountText" Text="0" TextWrapping="Wrap" Style="{DynamicResource CED.Text.Primary}"/>
                <TextBlock Grid.Row="6" Text="Leader / orientation:" Style="{StaticResource TagByExample.Label}"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Name="LeaderText" Text="-" TextWrapping="Wrap" Style="{DynamicResource CED.Text.Primary}"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource TagByExample.Card}">
            <StackPanel>
              <TextBlock Text="Targets"
                         Style="{DynamicResource CED.Text.SectionHeader}"
                         Margin="0,0,0,6"/>
              <ComboBox Name="TargetModeCombo"
                        SelectionChanged="target_mode_changed"
                        SelectedIndex="0"
                        Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}">
                <ComboBoxItem Tag="type" Content="All visible elements of the same type"/>
                <ComboBoxItem Tag="family" Content="All visible elements of the same family"/>
                <ComboBoxItem Tag="category" Content="All visible elements of the same category"/>
                <ComboBoxItem Tag="manual" Content="User selection"/>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <Button Name="NewTargetsButton" Content="New" Width="62" Height="28" Margin="0,0,5,0" Style="{DynamicResource CED.Button.Base}" Click="new_targets_clicked" IsEnabled="False"/>
                <Button Name="UseCurrentSelectionButton" Content="Use Current Selection" Width="150" Height="28" Margin="0,0,5,0" Style="{DynamicResource CED.Button.Base}" Click="use_current_selection_clicked" IsEnabled="False"/>
                <Button Name="ClearTargetsButton" Content="Clear" Width="62" Height="28" Style="{DynamicResource CED.Button.Base}" Click="clear_targets_clicked" IsEnabled="False"/>
              </StackPanel>
              <CheckBox Name="IncludeNestedToggle"
                        Content="Include nested family instances"
                        Margin="0,7,0,0"
                        Style="{DynamicResource CED.Input.CheckBox}"
                        Checked="option_changed"
                        Unchecked="option_changed"/>
              <TextBlock Name="TargetCountText" Text="Targets: 0" Margin="0,6,0,0" Style="{DynamicResource CED.Text.Primary}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource TagByExample.Card}">
            <StackPanel>
              <TextBlock Text="Placement"
                         Style="{DynamicResource CED.Text.SectionHeader}"
                         Margin="0,0,0,6"/>
              <CheckBox Name="PreserveRotationToggle" Content="Preserve tag rotation relative to the host" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Checked="option_changed" Unchecked="option_changed"/>
              <CheckBox Name="UseModelOrientationToggle" Content="Use model orientation" IsChecked="True" Margin="0,6,0,0" Style="{DynamicResource CED.Input.CheckBox}" Checked="option_changed" Unchecked="option_changed"/>
              <CheckBox Name="CopyLeaderToggle" Content="Copy leader" IsChecked="True" Margin="0,6,0,0" Style="{DynamicResource CED.Input.CheckBox}" Checked="option_changed" Unchecked="option_changed"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource TagByExample.Card}">
            <StackPanel>
              <TextBlock Text="Existing Tags"
                         Style="{DynamicResource CED.Text.SectionHeader}"
                         Margin="0,0,0,6"/>
              <RadioButton Name="ReplaceAllRadio" Content="Replace all tags" GroupName="ExistingTags" IsChecked="False" Style="{DynamicResource CED.Input.RadioButton}" Checked="option_changed"/>
              <RadioButton Name="ReplaceMatchingRadio" Content="Replace matching reference tag types only" GroupName="ExistingTags" Margin="0,6,0,0" Style="{DynamicResource CED.Input.RadioButton}" Checked="option_changed"/>
              <RadioButton Name="SkipMatchingRadio" Content="Skip matching reference tag types" GroupName="ExistingTags" IsChecked="True" Margin="0,6,0,0" Style="{DynamicResource CED.Input.RadioButton}" Checked="option_changed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Name="SelectionInstructionsPanel"
              Panel.ZIndex="10"
              Visibility="Collapsed"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch"
              Margin="10,10,26,0"
              Style="{DynamicResource CED.Alert.Info}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Path Grid.Column="0"
                Data="{DynamicResource CED.Icon.Alert.Info}"
                Margin="0,0,8,0"
                Style="{DynamicResource CED.Alert.Icon.Info}"/>
          <TextBlock Grid.Column="1"
                     Name="SelectionInstructionsText"
                     Visibility="Collapsed"
                     Style="{DynamicResource CED.Alert.Text.Info}"/>
        </Grid>
      </Border>

      <Border Name="ErrorBannerPanel"
              Panel.ZIndex="11"
              Visibility="Collapsed"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch"
              Margin="10,10,26,0"
              Style="{DynamicResource CED.Alert.Error}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Path Grid.Column="0"
                Data="{DynamicResource CED.Icon.Alert.Error}"
                Margin="0,0,8,0"
                Style="{DynamicResource CED.Alert.Icon.Error}"/>
          <TextBlock Grid.Column="1"
                     Name="ErrorBannerText"
                     Style="{DynamicResource CED.Alert.Text.Error}"/>
          <Button Grid.Column="2"
                  Name="DismissErrorButton"
                  Width="24"
                  Height="24"
                  Margin="8,0,0,0"
                  Padding="0"
                  ToolTip="Dismiss"
                  Style="{DynamicResource CED.Button.IconSmall}"
                  Click="dismiss_error_clicked">
            <Path Data="{DynamicResource CED.Icon.Close}"
                  Style="{DynamicResource CED.Alert.Icon.Error}"
                  Width="12"
                  Height="12"/>
          </Button>
        </Grid>
      </Border>
      </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Name="StatusText"
                 Grid.Column="0"
                 Text="Select an example tag to begin."
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Style="{DynamicResource CED.Text.Secondary}"
                 Margin="0,0,8,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Name="CloseButton"
                Content="Close"
                Width="92"
                Height="30"
                Margin="0,0,6,0"
                Style="{DynamicResource CED.Button.Base}"
                Click="close_clicked"/>
        <Button Name="CreateButton"
                Content="Create Tags"
                Width="100"
                Height="30"
                Style="{DynamicResource CED.Button.Apply}"
                Click="create_clicked"
                IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
