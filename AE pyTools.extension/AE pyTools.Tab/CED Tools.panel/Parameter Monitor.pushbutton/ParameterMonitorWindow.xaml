<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Monitor"
        Width="1500"
        Height="960"
        MinWidth="1280"
        MinHeight="650"
        PreviewKeyDown="window_preview_key_down"
        Activated="window_activated"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource CED.Brush.WindowBackground}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}" />
        </Style>
        <Style x:Key="PM.Button" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.ButtonDefaultBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Border x:Name="StateOverlay" CornerRadius="4" Background="Transparent" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PM.PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PM.Button}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.AccentBlue}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.ButtonForegroundOnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentBlue}" />
        </Style>
        <Style x:Key="PM.ScanButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PM.PrimaryButton}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="PM.DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PM.Button}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AccentRed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentRed}" />
        </Style>
        <Style x:Key="PM.Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridRowForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridBorder}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CED.Brush.DataGridCellBorder}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CED.Brush.DataGridAltRow}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridHeaderBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridHeaderForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridHeaderBorder}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PM.GridHeaderFilterButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.SecondaryText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{DynamicResource CED.Icon.Filter}"
                                      Fill="{TemplateBinding Foreground}" Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CED.Brush.CircuitItemHoverBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource CED.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CED.Brush.Accent}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource CED.Brush.ButtonForegroundOnAccent}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Active" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource CED.Brush.Accent}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PM.DataGridCellBase" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridCellBorder}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridRowForeground}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridSelectionBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridSelectionForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PM.DataGridCellBase}" />
        <Style x:Key="PM.CheckboxColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridHeaderBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridHeaderForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridHeaderBorder}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PM.CheckboxCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PM.DataGridCellBase}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PM.TrackingSetCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.SearchBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemHoverBackground}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding active}" Value="False">
                    <Setter Property="Opacity" Value="0.52" />
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.SurfaceAlt}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.TrackingSetItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PM.SetActiveBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeStd02Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeStd02Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding active}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridErrorBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentRed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.SetActiveBadgeText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeStd02Text}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding active}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AccentRed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.ElementRow" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridRowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridRowForeground}" />
            <Setter Property="MinHeight" Value="28" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridAltRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Untracked">
                    <Setter Property="Opacity" Value="0.52" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.SecondaryText}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridSelectionBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridSelectionForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.StatusBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeStd04Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeStd04Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeWarningBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Added">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeStd02Background}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeStd02Border}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Removed">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridErrorBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentRed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.StatusBadgeText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeStd04Text}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Changed"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" /></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Added"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeStd02Text}" /></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Removed"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.AccentRed}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.InspectorStatusBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource PM.StatusBadge}">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Changed"><Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeWarningBorder}" /></Trigger>
                <Trigger Property="Tag" Value="Added"><Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeStd02Background}" /><Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeStd02Border}" /></Trigger>
                <Trigger Property="Tag" Value="Removed"><Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridErrorBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentRed}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.InspectorStatusText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeStd04Text}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="Changed"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" /></DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="Added"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeStd02Text}" /></DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="Removed"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.AccentRed}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.SetChangesBadge" TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeWarningBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding has_changes}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.ChangeCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PM.DataGridCellBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding parameter_change_state}" Value="Changed"><Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" /><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.LocationCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PM.DataGridCellBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding location_state}" Value="Unchanged"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.SecondaryText}" /><Setter Property="Opacity" Value="0.62" /></DataTrigger>
                <DataTrigger Binding="{Binding location_state}" Value="Untracked"><Setter Property="Foreground" Value="{DynamicResource CED.Brush.SecondaryText}" /><Setter Property="Opacity" Value="0.55" /><Setter Property="FontStyle" Value="Italic" /></DataTrigger>
                <DataTrigger Binding="{Binding location_state}" Value="Changed"><Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" /><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.MissingCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PM.DataGridCellBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding missing_state}" Value="Missing">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.FamilyChangeCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PM.DataGridCellBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding family_change_state}" Value="Changed"><Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" /><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.TypeChangeCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PM.DataGridCellBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding type_change_state}" Value="Changed"><Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" /><Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.PropertyRow" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridRowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridRowForeground}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridAltRow}" /></DataTrigger>
                <DataTrigger Binding="{Binding changed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding state}" Value="Missing">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding state}" Value="Missing Parameter">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeWarningBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.BadgeWarningText}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridSelectionBackground}" /><Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridSelectionForeground}" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="ConsoleRowDefinition" Height="Auto" MinHeight="0" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14243A" Padding="12,9">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="5" BorderBrush="#2E8BFF" BorderThickness="2" Margin="0,0,10,0">
                        <TextBlock Text="PM" Foreground="#73B7FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PARAMETER MONITOR" Foreground="White" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="Accepted-baseline review for host and linked model data" Foreground="#CFD8E6" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel x:Name="HeaderActionsPanel" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PM.PrimaryButton}" Content="+ Add Set" Click="add_set_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Edit Set" Click="edit_set_clicked" />
                    <Button Style="{StaticResource PM.ScanButton}" Content="Scan Selected Set" ToolTip="Scan the selected set against the current Revit model. This does not accept changes." Click="check_set_clicked" />
                    <Button Style="{StaticResource PM.ScanButton}" Content="Scan All Active Sets" ToolTip="Scan every active set. Deactivated sets are skipped." Click="check_all_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Export Sets" Click="export_sets_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Import Sets" Click="import_sets_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Export Report" Click="export_report_clicked" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TrackingSetsColumn" Width="290" MinWidth="0" />
                <ColumnDefinition x:Name="TrackingSetsSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition x:Name="RightPanelSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="480" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="TrackingSetsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" />
            <GridSplitter x:Name="RightPanelSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" />

            <Border x:Name="TrackingSetsPanel" Grid.Column="0" Style="{StaticResource PM.Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="TRACKING SETS" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ReloadProjectDataButton" Style="{StaticResource PM.Button}" Content="Reload Project Data" ToolTip="Re-read persisted monitor data if another command or session changed it. This does not scan the model." Padding="7,3" Click="refresh_store_clicked" />
                            <Button x:Name="CollapseTrackingSetsButton" Style="{StaticResource PM.Button}" Content="◀" ToolTip="Collapse Tracking Sets" Padding="7,3" Click="collapse_tracking_sets_clicked" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="TrackingSetList" Grid.Row="1" SelectionChanged="tracking_set_selection_changed"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource PM.TrackingSetItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PM.TrackingSetCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Style="{StaticResource PM.SetActiveBadge}">
                                                <TextBlock Text="{Binding active_text}" Style="{StaticResource PM.SetActiveBadgeText}" />
                                            </Border>
                                            <Border Style="{StaticResource PM.SetChangesBadge}" Margin="4,0,0,0">
                                                <TextBlock Text="CHANGES DETECTED" Foreground="{DynamicResource CED.Brush.BadgeWarningText}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{Binding model_text}" Foreground="{DynamicResource CED.Brush.SecondaryText}" FontSize="10" Margin="0,5,0,0" />
                                        <DockPanel Grid.Row="3" Margin="0,5,0,0" LastChildFill="False">
                                            <TextBlock Text="{Binding changed_text}" Foreground="{DynamicResource CED.Brush.BadgeWarningText}" FontSize="10" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding added_text}" Foreground="{DynamicResource CED.Brush.AccentGreen}" FontSize="10" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding removed_text}" Foreground="{DynamicResource CED.Brush.AccentRed}" FontSize="10" Margin="0,0,8,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding element_count_text}" FontSize="10" Foreground="{DynamicResource CED.Brush.SecondaryText}" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="TrackingSetsFooterPanel" Grid.Row="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource PM.Button}" Content="Toggle Set Active State" ToolTip="Inactive sets remain stored but are skipped by Scan All Active Sets." Click="toggle_active_clicked" />
                        <Button Style="{StaticResource PM.DangerButton}" Content="Delete Selected Set" Click="delete_set_clicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TrackingSetsCollapsedStrip" Grid.Column="0" Style="{StaticResource PM.Card}" Margin="0" Padding="2" Visibility="Collapsed">
                <Button Style="{StaticResource PM.Button}" ToolTip="Expand Tracking Sets"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="expand_tracking_sets_clicked">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRACKING SETS" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                        </TextBlock>
                        <TextBlock Text="▶" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Button>
            </Border>

            <Grid x:Name="MiddleColumnGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PM.Card}" Margin="0,0,0,7">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock x:Name="SetTitleText" Text="Select a Tracking Set" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="SetSubtitleText" Text="-" Foreground="{DynamicResource CED.Brush.SecondaryText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="SetStatusText" Text="Never Checked" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="SetLastCheckText" Text="Last check: Never" FontSize="10" Foreground="{DynamicResource CED.Brush.SecondaryText}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Expander Grid.Row="1" Margin="0,0,0,7" IsExpanded="True">
                    <Expander.Header><TextBlock Text="SET SUMMARY" FontWeight="Bold" /></Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="ChangedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CED.Brush.BadgeWarningText}" /><TextBlock Text="Changed" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="AddedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CED.Brush.AccentGreen}" /><TextBlock Text="Added" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="RemovedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CED.Brush.AccentRed}" /><TextBlock Text="Removed" /></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="UnchangedCountText" Text="0" FontSize="24" FontWeight="Bold" /><TextBlock Text="Unchanged" /></StackPanel></Border>
                    </Grid>
                </Expander>

                <Border Grid.Row="2" Style="{StaticResource PM.Card}" Margin="0,0,0,7" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0">
                            <TextBox x:Name="SearchTextBox" Width="225" Margin="3" Padding="7,4" Style="{DynamicResource CED.Input.TextBox}" TextChanged="search_text_changed" />
                            <ComboBox x:Name="FilterCombo" Width="155" Margin="3" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" DisplayMemberPath="label" SelectionChanged="filter_selection_changed" />
                            <Button x:Name="ResetFiltersButton" Style="{StaticResource PM.Button}" Content="Reset Filters"
                                    IsEnabled="False" ToolTip="Clear search, row-status, and all column filters."
                                    Click="reset_filters_clicked" />
                            <Button x:Name="ColumnsButton" Style="{StaticResource PM.Button}" Content="Columns ▾" ToolTip="Show or hide main-grid columns." Click="columns_menu_clicked" />
                        </WrapPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button x:Name="ToggleLocationButton" Style="{StaticResource PM.Button}"
                                    Content="Toggle Location Tracking" ToolTip="Enable or disable location tracking for the selected element(s)." Click="toggle_location_clicked" />
                            <TextBlock x:Name="ElementCountText" VerticalAlignment="Center" Margin="8,0" Text="0 elements" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="ElementGrid" Grid.Row="3" Style="{DynamicResource CED.DataGrid.Display.Alternating}" SelectionChanged="element_selection_changed"
                          Margin="0,0,0,7"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                          PreviewMouseLeftButtonDown="element_grid_preview_mouse_down"
                          PreviewMouseMove="element_grid_preview_mouse_move"
                          RowStyle="{StaticResource PM.ElementRow}"
                          RowHeight="28"
                          SelectionMode="Extended"
                          CanUserReorderColumns="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          FrozenColumnCount="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="38" MinWidth="38" MaxWidth="38"
                                                CanUserResize="False" CanUserReorder="False" CanUserSort="False"
                                                HeaderStyle="{StaticResource PM.CheckboxColumnHeader}"
                                                CellStyle="{StaticResource PM.CheckboxCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}"
                                              Style="{DynamicResource CED.Input.CheckBox}"
                                              Width="16" Height="18" MinWidth="16"
                                              Focusable="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PM.StatusBadge}">
                                        <TextBlock Text="{Binding status}" Style="{StaticResource PM.StatusBadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Family" Binding="{Binding family}" Width="180" MinWidth="120" CellStyle="{StaticResource PM.FamilyChangeCell}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="210" MinWidth="140" CellStyle="{StaticResource PM.TypeChangeCell}" />
                        <DataGridTextColumn Header="ID" Binding="{Binding element_id}" Width="90" MinWidth="72" />
                        <DataGridTextColumn Header="Level" Binding="{Binding level}" Width="105" MinWidth="80" />
                        <DataGridTextColumn Header="Param Δ" Binding="{Binding parameter_change_text}" Width="84" MinWidth="72" CellStyle="{StaticResource PM.ChangeCell}" />
                        <DataGridTextColumn Header="Param Missing" Binding="{Binding missing_text}" Width="98" MinWidth="84" CellStyle="{StaticResource PM.MissingCell}" />
                        <DataGridTextColumn Header="Location" Binding="{Binding location_text}" Width="105" MinWidth="90" CellStyle="{StaticResource PM.LocationCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="4" Background="{DynamicResource CED.Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource CED.Brush.Border}"
                        BorderThickness="1" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusBarText"
                                   Grid.Column="0"
                                   Text="Ready. Reload Saved Data reads storage; scans read the current model; scans never accept changes automatically."
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="StatusActionsPanel" Grid.Column="1"
                                    Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource PM.PrimaryButton}" Content="Accept All Changes in Set"
                                    ToolTip="Accept the current values as the new baseline for this set."
                                    Click="resolve_set_clicked" />
                            <Button Style="{StaticResource PM.DangerButton}" Content="Delete Removed Records"
                                    ToolTip="Permanently remove records for elements no longer found in the model."
                                    Click="remove_all_removed_clicked" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="RightPanelBorder" Grid.Column="4" Style="{StaticResource PM.Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel>
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="ELEMENT DETAILS" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource PM.Button}" Content="▶"
                                    ToolTip="Collapse the details panel" Padding="7,3"
                                    Click="collapse_right_panel_clicked" />
                        </DockPanel>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock x:Name="ElementTitleText" Text="Select an element" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="ElementTypeText" Text="" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="ElementContextText" Text="-" Foreground="{DynamicResource CED.Brush.SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <Border x:Name="ElementStatusBadge" Style="{StaticResource PM.InspectorStatusBadge}" Visibility="Collapsed" Margin="0,5,0,0">
                                <TextBlock x:Name="ElementStatusText" Text="Unchanged" Style="{StaticResource PM.InspectorStatusText}" />
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ShowElementButton" Style="{StaticResource PM.Button}" Content="Show in Model" Click="show_element_clicked" />
                                <Button x:Name="SelectElementButton" Style="{StaticResource PM.Button}" Content="Select in Model" Click="select_element_clicked" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                    <Expander x:Name="ParametersExpander" IsExpanded="True" Margin="0,8,0,0"
                              Expanded="parameters_expander_expanded" Collapsed="parameters_expander_collapsed">
                        <Expander.Header><TextBlock Text="PARAMETERS" FontWeight="Bold" /></Expander.Header>
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="PropertyGrid" Grid.Row="0" Style="{DynamicResource CED.DataGrid.Display.Alternating}" SelectionChanged="property_selection_changed"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      RowStyle="{StaticResource PM.PropertyRow}"
                                      MinHeight="150"
                                      EnableRowVirtualization="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Property" Binding="{Binding name}" Width="1.3*" MinWidth="105" />
                                    <DataGridTextColumn Header="Scope" Binding="{Binding scope}" Width="0.65*" MinWidth="58" />
                                    <DataGridTextColumn Header="Accepted" Binding="{Binding accepted}" Width="1.1*" MinWidth="90" />
                                    <DataGridTextColumn Header="Current" Binding="{Binding current}" Width="1.1*" MinWidth="90" />
                                    <DataGridTextColumn Header="State" Binding="{Binding state}" Width="0.8*" MinWidth="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button x:Name="ResolvePropertyButton" Style="{StaticResource PM.Button}" Content="Resolve Property" Click="resolve_property_clicked" />
                                <Button x:Name="ResolveElementButton" Style="{StaticResource PM.PrimaryButton}" Content="Resolve Element" Click="resolve_element_clicked" />
                                <Button x:Name="UntrackButton" Style="{StaticResource PM.DangerButton}" Content="Untrack" Click="untrack_clicked" />
                                <Button x:Name="RestoreButton" Style="{StaticResource PM.Button}" Content="Restore Tracking" Click="restore_clicked" />
                                <Button x:Name="RemoveRecordButton" Style="{StaticResource PM.DangerButton}" Content="Remove Record" Click="remove_record_clicked" />
                            </WrapPanel>
                        </Grid>
                    </Expander>
                    <Border BorderBrush="{DynamicResource CED.Brush.InfoPanelBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource CED.Brush.InfoPanelBackground}" Padding="8" Margin="0,8,0,0">
                        <Expander IsExpanded="True">
                            <Expander.Header><TextBlock Text="LINKED CHILD ELEMENTS" FontWeight="Bold" /></Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                    <Button x:Name="SyncElementLinkerButton" DockPanel.Dock="Right"
                                            Style="{StaticResource PM.PrimaryButton}" Content="Sync Element Linker"
                                            ToolTip="Scan the model for elements with a populated Element_Linker parameter, then register them (and their host or linked-model parents) for monitoring."
                                            Click="sync_element_linker_clicked" />
                                    <TextBlock x:Name="ChildrenSummaryText" Text="No linked children"
                                               Margin="0,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DataGrid x:Name="ChildrenGrid" MinHeight="100" Margin="0,0,0,6" Style="{DynamicResource CED.DataGrid.Display.Alternating}"
                                          SelectionChanged="children_selection_changed"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          RowStyle="{StaticResource PM.PropertyRow}"
                                          EnableRowVirtualization="False"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Family" Binding="{Binding family}" Width="1.3*" MinWidth="110" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="1.3*" MinWidth="110" />
                                        <DataGridTextColumn Header="Origin" Binding="{Binding origin}" Width="0.7*" MinWidth="60" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel>
                                    <Button x:Name="MoveWithParentButton" Style="{StaticResource PM.PrimaryButton}" Content="Move Children with Parent"
                                            ToolTip="Move every linked child of the selected parent by the same translation and rotation the parent moved since its accepted location."
                                            IsEnabled="False" Click="move_with_parent_clicked" />
                                </WrapPanel>
                                <Border Height="1" Background="{DynamicResource CED.Brush.Border}" Margin="0,7,0,8" />
                                <TextBlock x:Name="RelationshipText" Text="No host device linked" Margin="0,0,0,5" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,0,0,2">
                                    <Button x:Name="LinkDeviceButton" Style="{StaticResource PM.PrimaryButton}" Content="Add Device" ToolTip="Pick or change the linked host electrical device." Click="link_device_clicked" />
                                    <Button x:Name="UnlinkDeviceButton" Style="{StaticResource PM.DangerButton}" Content="Unlink" Click="unlink_device_clicked" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="SelectDeviceButton" Style="{StaticResource PM.Button}" Content="Select Device" Click="select_device_clicked" />
                                    <Button x:Name="ShowDeviceButton" Style="{StaticResource PM.Button}" Content="Show Device" Click="show_device_clicked" />
                                    <Button x:Name="SelectCircuitButton" Style="{StaticResource PM.Button}" Content="Select Circuit" Click="select_circuit_clicked" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="RightPanelCollapsedStrip" Grid.Column="4" Style="{StaticResource PM.Card}" Margin="0" Padding="2" Visibility="Collapsed">
                <Button Style="{StaticResource PM.Button}" ToolTip="Expand the details panel"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="expand_right_panel_clicked">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ELEMENT DETAILS" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                        </TextBlock>
                        <TextBlock Text="◀" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource CED.Brush.Border}" />

        <Border x:Name="ConsoleBorder" Grid.Row="3" Background="{DynamicResource CED.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource CED.Brush.Border}" BorderThickness="0,1,0,0"
                Padding="8,5">
            <Expander x:Name="ConsoleExpander" IsExpanded="False"
                      Expanded="console_expander_expanded" Collapsed="console_expander_collapsed">
                <Expander.Header><TextBlock Text="OUTPUT CONSOLE" FontWeight="Bold" /></Expander.Header>
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PM.Button}"
                            Content="Clear" Padding="8,2" Click="clear_console_clicked" />
                </DockPanel>
                <TextBox x:Name="OutputConsoleTextBox" Grid.Row="1" IsReadOnly="True"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="11" Padding="6"
                         Background="{DynamicResource CED.Brush.DataGridBackground}"
                         Foreground="{DynamicResource CED.Brush.PrimaryText}"
                         BorderBrush="{DynamicResource CED.Brush.Border}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Grid>
            </Expander>
        </Border>
    </Grid>
</Window>
