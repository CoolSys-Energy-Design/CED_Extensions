<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Monitor"
        Width="1500"
        Height="960"
        MinWidth="1280"
        MinHeight="650"
        PreviewKeyDown="window_preview_key_down"
        Activated="window_activated"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CED.Brush.WindowBackground}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}" />
        </Style>
        <Style x:Key="PM.Button" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.ButtonDefaultBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PM.PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PM.Button}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.ButtonForegroundOnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}" />
        </Style>
        <Style x:Key="PM.ScanButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PM.PrimaryButton}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="PM.DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PM.Button}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AccentRed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentRed}" />
        </Style>
        <Style x:Key="PM.Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridRowForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridBorder}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CED.Brush.DataGridCellBorder}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CED.Brush.DataGridAltRow}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridHeaderBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridHeaderForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridHeaderBorder}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PM.TrackingSetCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding active}" Value="False">
                    <Setter Property="Opacity" Value="0.52" />
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.SurfaceAlt}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.SetActiveBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#2D2EAF68" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding active}" Value="False">
                    <Setter Property="Background" Value="#35D64545" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.ElementRow" TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Untracked">
                    <Setter Property="Opacity" Value="0.52" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.SecondaryText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.StatusBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#2D8795A8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Changed"><Setter Property="Background" Value="#3DD6A517" /></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Added"><Setter Property="Background" Value="#3D2EAF68" /></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Removed"><Setter Property="Background" Value="#3DD64545" /></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Missing Parameter"><Setter Property="Background" Value="#3DD58512" /></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Untracked"><Setter Property="Background" Value="#3D75808C" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.ChangeCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding parameter_change_state}" Value="Changed"><Setter Property="Background" Value="#3DD6A517" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.LocationChangeCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding location_change_state}" Value="Changed"><Setter Property="Background" Value="#3DD6A517" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.FamilyChangeCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding family_change_state}" Value="Changed"><Setter Property="Background" Value="#3DD6A517" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.TypeChangeCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding type_change_state}" Value="Changed"><Setter Property="Background" Value="#3DD6A517" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PM.PropertyRow" TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding changed}" Value="True">
                    <Setter Property="Background" Value="#2AEB5757" />
                    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AccentRed}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding state}" Value="Missing">
                    <Setter Property="Background" Value="#20D58512" />
                    <Setter Property="Foreground" Value="#D58512" />
                </DataTrigger>
                <DataTrigger Binding="{Binding state}" Value="Missing Parameter">
                    <Setter Property="Background" Value="#20D58512" />
                    <Setter Property="Foreground" Value="#D58512" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="ConsoleRowDefinition" Height="130" MinHeight="80" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14243A" Padding="12,9">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="5" BorderBrush="#2E8BFF" BorderThickness="2" Margin="0,0,10,0">
                        <TextBlock Text="PM" Foreground="#73B7FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PARAMETER MONITOR" Foreground="White" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="Accepted-baseline review for host and linked model data" Foreground="#CFD8E6" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel x:Name="HeaderActionsPanel" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PM.PrimaryButton}" Content="+ Add Set" Click="add_set_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Edit Set" Click="edit_set_clicked" />
                    <Button Style="{StaticResource PM.ScanButton}" Content="Scan Selected Set" ToolTip="Scan the selected set against the current Revit model. This does not accept changes." Click="check_set_clicked" />
                    <Button Style="{StaticResource PM.ScanButton}" Content="Scan All Active Sets" ToolTip="Scan every active set. Deactivated sets are skipped." Click="check_all_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Export Sets" Click="export_sets_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Import Sets" Click="import_sets_clicked" />
                    <Button Style="{StaticResource PM.Button}" Content="Export Report" Click="export_report_clicked" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TrackingSetsColumn" Width="290" MinWidth="0" />
                <ColumnDefinition x:Name="TrackingSetsSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition x:Name="RightPanelSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="480" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="TrackingSetsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" />
            <GridSplitter x:Name="RightPanelSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" />

            <Border x:Name="TrackingSetsPanel" Grid.Column="0" Style="{StaticResource PM.Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="TRACKING SETS" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ReloadProjectDataButton" Style="{StaticResource PM.Button}" Content="Reload Project Data" ToolTip="Re-read persisted monitor data if another command or session changed it. This does not scan the model." Padding="7,3" Click="refresh_store_clicked" />
                            <Button x:Name="CollapseTrackingSetsButton" Style="{StaticResource PM.Button}" Content="◀" ToolTip="Collapse Tracking Sets" Padding="7,3" Click="collapse_tracking_sets_clicked" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="TrackingSetList" Grid.Row="1" SelectionChanged="tracking_set_selection_changed"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PM.TrackingSetCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="13" />
                                            <Border DockPanel.Dock="Right" Style="{StaticResource PM.SetActiveBadge}">
                                                <TextBlock Text="{Binding active_text}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding subtitle}" Foreground="{DynamicResource CED.Brush.SecondaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding counts_text}" FontSize="10" Margin="0,5,0,0" />
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding status_text}" FontWeight="SemiBold" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding last_check}" FontSize="9" Foreground="{DynamicResource CED.Brush.SecondaryText}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="TrackingSetsFooterPanel" Grid.Row="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource PM.Button}" Content="Toggle Set Active State" ToolTip="Inactive sets remain stored but are skipped by Scan All Active Sets." Click="toggle_active_clicked" />
                        <Button Style="{StaticResource PM.DangerButton}" Content="Delete Selected Set" Click="delete_set_clicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TrackingSetsCollapsedStrip" Grid.Column="0" Style="{StaticResource PM.Card}" Margin="0" Padding="2" Visibility="Collapsed">
                <Button Style="{StaticResource PM.Button}" Content="▶" ToolTip="Expand Tracking Sets"
                        Padding="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="expand_tracking_sets_clicked" />
            </Border>

            <Grid x:Name="MiddleColumnGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PM.Card}" Margin="0,0,0,7">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock x:Name="SetTitleText" Text="Select a Tracking Set" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="SetSubtitleText" Text="-" Foreground="{DynamicResource CED.Brush.SecondaryText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="SetStatusText" Text="Never Checked" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="SetLastCheckText" Text="Last check: Never" FontSize="10" Foreground="{DynamicResource CED.Brush.SecondaryText}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Expander Grid.Row="1" Margin="0,0,0,7" IsExpanded="True">
                    <Expander.Header><TextBlock Text="SET SUMMARY" FontWeight="Bold" /></Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="ChangedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CED.Brush.AccentRed}" /><TextBlock Text="Changed" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="AddedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CED.Brush.AccentGreen}" /><TextBlock Text="Added" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="RemovedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#D58512" /><TextBlock Text="Removed" /></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource PM.Card}"><StackPanel><TextBlock x:Name="UnchangedCountText" Text="0" FontSize="24" FontWeight="Bold" /><TextBlock Text="Unchanged" /></StackPanel></Border>
                    </Grid>
                </Expander>

                <Border Grid.Row="2" Style="{StaticResource PM.Card}" Margin="0,0,0,7" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0">
                            <TextBox x:Name="SearchTextBox" Width="225" Margin="3" Padding="7,4" TextChanged="search_text_changed" />
                            <ComboBox x:Name="FilterCombo" Width="155" Margin="3" DisplayMemberPath="label" SelectionChanged="filter_selection_changed" />
                            <Button x:Name="ColumnsButton" Style="{StaticResource PM.Button}" Content="Columns ▾" ToolTip="Show or hide main-grid columns." Click="columns_menu_clicked" />
                        </WrapPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button x:Name="ToggleLocationButton" Style="{StaticResource PM.Button}"
                                    Content="Toggle Location Tracking" ToolTip="Enable or disable location tracking for the selected element(s)." Click="toggle_location_clicked" />
                            <TextBlock x:Name="ElementCountText" VerticalAlignment="Center" Margin="8,0" Text="0 elements" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="ElementGrid" Grid.Row="3" SelectionChanged="element_selection_changed"
                          PreviewMouseLeftButtonDown="element_grid_preview_mouse_down"
                          PreviewMouseMove="element_grid_preview_mouse_move"
                          RowStyle="{StaticResource PM.ElementRow}"
                          SelectionMode="Extended"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PM.StatusBadge}">
                                        <TextBlock Text="{Binding status}" Foreground="#14243A" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Element" Binding="{Binding element}" Width="*" MinWidth="130" />
                        <DataGridTextColumn Header="Family" Binding="{Binding family}" Width="1.1*" MinWidth="120" CellStyle="{StaticResource PM.FamilyChangeCell}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="1.1*" MinWidth="120" CellStyle="{StaticResource PM.TypeChangeCell}" />
                        <DataGridTextColumn Header="ID" Binding="{Binding element_id}" Width="75" />
                        <DataGridTextColumn Header="Level" Binding="{Binding level}" Width="100" />
                        <DataGridTextColumn Header="Parameter Changes" Binding="{Binding parameter_change_text}" Width="105" CellStyle="{StaticResource PM.ChangeCell}" />
                        <DataGridTextColumn Header="Missing" Binding="{Binding missing_count}" Width="65" />
                        <DataGridTextColumn Header="Location Tracking" Binding="{Binding location_text}" Width="95" />
                        <DataGridTextColumn Header="Location Change" Binding="{Binding location_change_text}" Width="95" CellStyle="{StaticResource PM.LocationChangeCell}" />
                        <DataGridTextColumn Header="Circuit / Device" Binding="{Binding circuit}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border x:Name="RightPanelBorder" Grid.Column="4" Style="{StaticResource PM.Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ParametersRowDefinition" Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="ELEMENT DETAILS" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource PM.Button}" Content="▶"
                                    ToolTip="Collapse the details panel" Padding="7,3"
                                    Click="collapse_right_panel_clicked" />
                        </DockPanel>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock x:Name="ElementTitleText" Text="Select an element" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="ElementContextText" Text="-" Foreground="{DynamicResource CED.Brush.SecondaryText}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ShowElementButton" Style="{StaticResource PM.Button}" Content="Show in Model" Click="show_element_clicked" />
                                <Button x:Name="SelectElementButton" Style="{StaticResource PM.Button}" Content="Select in Model" Click="select_element_clicked" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                    <Expander Grid.Row="1" x:Name="ParametersExpander" IsExpanded="True" Margin="0,8,0,0"
                              Expanded="parameters_expander_expanded" Collapsed="parameters_expander_collapsed">
                        <Expander.Header><TextBlock Text="PARAMETERS" FontWeight="Bold" /></Expander.Header>
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="PropertyGrid" Grid.Row="0" SelectionChanged="property_selection_changed"
                                      RowStyle="{StaticResource PM.PropertyRow}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Property" Binding="{Binding name}" Width="1.3*" MinWidth="105" />
                                    <DataGridTextColumn Header="Scope" Binding="{Binding scope}" Width="0.65*" MinWidth="58" />
                                    <DataGridTextColumn Header="Accepted" Binding="{Binding accepted}" Width="1.1*" MinWidth="90" />
                                    <DataGridTextColumn Header="Current" Binding="{Binding current}" Width="1.1*" MinWidth="90" />
                                    <DataGridTextColumn Header="State" Binding="{Binding state}" Width="0.8*" MinWidth="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button x:Name="ResolvePropertyButton" Style="{StaticResource PM.Button}" Content="Resolve Property" Click="resolve_property_clicked" />
                                <Button x:Name="ResolveElementButton" Style="{StaticResource PM.PrimaryButton}" Content="Resolve Element" Click="resolve_element_clicked" />
                                <Button x:Name="UntrackButton" Style="{StaticResource PM.DangerButton}" Content="Untrack" Click="untrack_clicked" />
                                <Button x:Name="SyncElementLinkerButton" Style="{StaticResource PM.PrimaryButton}" Content="Sync Element Linker"
                                        ToolTip="Scan the model for elements with a populated Element_Linker parameter, then register them (and their host or linked-model parents) for monitoring."
                                        Click="sync_element_linker_clicked" />
                                <Button x:Name="RestoreButton" Style="{StaticResource PM.Button}" Content="Restore Tracking" Click="restore_clicked" />
                                <Button x:Name="RemoveRecordButton" Style="{StaticResource PM.DangerButton}" Content="Remove Record" Click="remove_record_clicked" />
                            </WrapPanel>
                        </Grid>
                    </Expander>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource CED.Brush.InfoPanelBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource CED.Brush.InfoPanelBackground}" Padding="8" Margin="0,8,0,0">
                        <Expander IsExpanded="True">
                            <Expander.Header><TextBlock Text="LINKED CHILDREN" FontWeight="Bold" /></Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock x:Name="ChildrenSummaryText" Text="No linked children" Margin="0,0,0,3" TextWrapping="Wrap" />
                                <DataGrid x:Name="ChildrenGrid" MaxHeight="160" Margin="0,0,0,6"
                                          SelectionChanged="children_selection_changed"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          RowStyle="{StaticResource PM.PropertyRow}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Family" Binding="{Binding family}" Width="1.3*" MinWidth="110" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="1.3*" MinWidth="110" />
                                        <DataGridTextColumn Header="Origin" Binding="{Binding origin}" Width="0.7*" MinWidth="60" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel>
                                    <Button x:Name="MoveWithParentButton" Style="{StaticResource PM.PrimaryButton}" Content="Move Children with Parent"
                                            ToolTip="Move every linked child of the selected parent by the same translation and rotation the parent moved since its accepted location."
                                            IsEnabled="False" Click="move_with_parent_clicked" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Grid.Row="3" BorderBrush="{DynamicResource CED.Brush.InfoPanelBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource CED.Brush.InfoPanelBackground}" Padding="8" Margin="0,8,0,0">
                        <Expander IsExpanded="True">
                            <Expander.Header><TextBlock Text="HOST DEVICE / CIRCUIT" FontWeight="Bold" /></Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock x:Name="RelationshipText" Text="No host device linked" Margin="0,0,0,3" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button x:Name="LinkDeviceButton" Style="{StaticResource PM.Button}" Content="Add Device" ToolTip="Pick or change the linked host electrical device." Click="link_device_clicked" />
                                    <Button x:Name="UnlinkDeviceButton" Style="{StaticResource PM.Button}" Content="Unlink" Click="unlink_device_clicked" />
                                    <Button x:Name="SelectDeviceButton" Style="{StaticResource PM.Button}" Content="Select Device" Click="select_device_clicked" />
                                    <Button x:Name="ShowDeviceButton" Style="{StaticResource PM.Button}" Content="Show Device" Click="show_device_clicked" />
                                    <Button x:Name="SelectCircuitButton" Style="{StaticResource PM.Button}" Content="Select Circuit" Click="select_circuit_clicked" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="RightPanelCollapsedStrip" Grid.Column="4" Style="{StaticResource PM.Card}" Margin="0" Padding="2" Visibility="Collapsed">
                <Button Style="{StaticResource PM.Button}" Content="◀" ToolTip="Expand the details panel"
                        Padding="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="expand_right_panel_clicked" />
            </Border>
        </Grid>

            <Border Grid.Row="1" Background="{DynamicResource CED.Brush.SurfaceAlt}" BorderBrush="{DynamicResource CED.Brush.Border}" BorderThickness="0,1,0,0" Padding="8,5">
                <DockPanel>
                    <TextBlock x:Name="StatusBarText" Text="Ready. Reload Saved Data reads storage; scans read the current model; scans never accept changes automatically." VerticalAlignment="Center" TextWrapping="Wrap" />
                    <WrapPanel x:Name="StatusActionsPanel" DockPanel.Dock="Right">
                        <Button Style="{StaticResource PM.Button}" Content="Accept All Changes in Set" ToolTip="Accept the current values as the new baseline for this set." Click="resolve_set_clicked" />
                        <Button Style="{StaticResource PM.DangerButton}" Content="Delete Removed Records" ToolTip="Permanently remove records for elements no longer found in the model." Click="remove_all_removed_clicked" />
                    </WrapPanel>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource CED.Brush.Border}" />

        <Border x:Name="ConsoleBorder" Grid.Row="3" Background="{DynamicResource CED.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource CED.Brush.Border}" BorderThickness="0,1,0,0"
                Padding="8,5">
            <Expander x:Name="ConsoleExpander" IsExpanded="True"
                      Expanded="console_expander_expanded" Collapsed="console_expander_collapsed">
                <Expander.Header><TextBlock Text="OUTPUT CONSOLE" FontWeight="Bold" /></Expander.Header>
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PM.Button}"
                            Content="Clear" Padding="8,2" Click="clear_console_clicked" />
                </DockPanel>
                <TextBox x:Name="OutputConsoleTextBox" Grid.Row="1" IsReadOnly="True"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="11" Padding="6"
                         Background="{DynamicResource CED.Brush.DataGridBackground}"
                         Foreground="{DynamicResource CED.Brush.PrimaryText}"
                         BorderBrush="{DynamicResource CED.Brush.Border}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Grid>
            </Expander>
        </Border>
    </Grid>
</Window>
