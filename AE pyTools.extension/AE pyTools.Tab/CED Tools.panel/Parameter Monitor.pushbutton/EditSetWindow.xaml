<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Tracking Set"
        Width="780" Height="720" MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource CED.Brush.WindowBackground}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}" />
        </Style>
        <Style x:Key="PM.EditCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="PM.ParameterChoiceItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Visibility" Value="{Binding visibility}" />
            <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemHoverBackground}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="EDIT TRACKING SET" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="Rename the set and choose the exact Revit parameters to monitor. Same-name parameters remain separate."
                       Foreground="{DynamicResource CED.Brush.SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PM.EditCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Set name" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="SetNameTextBox" Grid.Column="1"
                         Style="{DynamicResource CED.Input.TextBox}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PM.EditCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ParameterSearchTextBox" Grid.Column="0" Margin="0,0,10,0"
                         Style="{DynamicResource CED.Input.TextBox}"
                         ToolTip="Filter by parameter name, scope, kind, availability, or Revit data type."
                         TextChanged="parameter_search_changed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowCheckedOnlyCheckBox" Content="Show checked only"
                              Style="{DynamicResource CED.Input.CheckBox}"
                              Checked="parameter_filter_changed" Unchecked="parameter_filter_changed" />
                    <Button Content="Select visible" Margin="8,0,0,0"
                            Style="{DynamicResource CED.Button.Base}" Click="select_visible_clicked" />
                    <Button Content="Clear visible" Margin="6,0,0,0"
                            Style="{DynamicResource CED.Button.Base}" Click="clear_visible_clicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PM.EditCard}" Padding="0">
            <ListBox x:Name="ParameterList" BorderThickness="0"
                     Background="{DynamicResource CED.Brush.ListItemBackground}"
                     ItemContainerStyle="{StaticResource PM.ParameterChoiceItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Visibility="{Binding visibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Margin="0,1,9,0" VerticalAlignment="Top"
                                      IsChecked="{Binding checked}" Tag="{Binding}"
                                      Style="{DynamicResource CED.Input.CheckBox}"
                                      Checked="parameter_checked_changed" Unchecked="parameter_checked_changed" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding identity_text}" FontSize="10"
                                           Foreground="{DynamicResource CED.Brush.SecondaryText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding availability_text}" FontSize="10" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding value_shape_text}" FontSize="10" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource CED.Brush.SecondaryText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="SelectedCountText" Text="0 parameters selected" FontWeight="SemiBold" />
                <CheckBox x:Name="TrackNewElementsCheckBox" Margin="0,6,0,0"
                          Content="Track location by default for future added elements"
                          Style="{DynamicResource CED.Input.CheckBox}" />
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource CED.Brush.AccentRed}"
                           Margin="0,5,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Cancel" Margin="0,0,7,0"
                        Style="{DynamicResource CED.Button.Base}" Click="cancel_clicked" />
                <Button Content="Apply Changes"
                        Style="{DynamicResource CED.Button.Apply}" Click="accept_clicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
