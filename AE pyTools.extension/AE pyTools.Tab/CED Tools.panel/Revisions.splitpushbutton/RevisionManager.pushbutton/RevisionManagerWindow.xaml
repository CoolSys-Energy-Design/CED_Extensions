<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="Revision Cloud Manager"
        Height="850"
        Width="1460"
        MinHeight="650"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CED.Brush.WindowBackground}"
        Closing="window_closing">
  <Window.Resources>
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.HighlightBrushKey}" Color="{DynamicResource CED.Color.DataGridSelectionBackground}"/>
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource CED.Color.DataGridSelectionBackground}"/>
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.HighlightTextBrushKey}" Color="{DynamicResource CED.Color.DataGridSelectionForeground}"/>
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource CED.Color.DataGridSelectionForeground}"/>

    <Style x:Key="ControlSectionHeader" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridHeaderForeground}"/>
    </Style>

    <!-- 1px rule used to separate major control groups inside a card. -->
    <Style x:Key="SectionDivider" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="0,10,0,10"/>
      <Setter Property="Background" Value="{DynamicResource CED.Brush.SectionDivider}"/>
    </Style>

    <!-- Section header, one step down: titles a control group nested inside a section. -->
    <Style x:Key="ControlGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource ControlSectionHeader}">
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="NavigationCellText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.Link}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="0">
          <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!--
      Sheet cells. Nearly every cloud sits on one sheet, so the default template is a
      single navigable TextBlock; the WrapPanel of links is used only for the rows that
      genuinely span several sheets. Every sheet stays individually clickable either way.
      Do NOT set ContentTemplate on the ContentControl itself - a local value would
      outrank these style triggers and the multi-sheet template would never apply.
    -->
    <DataTemplate x:Key="SheetNumberCell.Single">
      <TextBlock Text="{Binding single_sheet_number}" Tag="{Binding single_sheet_number_id}" Style="{StaticResource NavigationCellText}" Margin="2,1,6,1" MouseLeftButtonDown="location_link_double_clicked"/>
    </DataTemplate>
    <DataTemplate x:Key="SheetNumberCell.Multi">
      <ItemsControl ItemsSource="{Binding sheet_number_links}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <TextBlock Text="{Binding text}" Tag="{Binding target_id}" Style="{StaticResource NavigationCellText}" Margin="2,1,6,1" MouseLeftButtonDown="location_link_double_clicked"/>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <DataTemplate x:Key="SheetNameCell.Single">
      <TextBlock Text="{Binding single_sheet_name}" Tag="{Binding single_sheet_name_id}" Style="{StaticResource NavigationCellText}" Margin="2,1,6,1" MouseLeftButtonDown="location_link_double_clicked"/>
    </DataTemplate>
    <DataTemplate x:Key="SheetNameCell.Multi">
      <ItemsControl ItemsSource="{Binding sheet_name_links}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <TextBlock Text="{Binding text}" Tag="{Binding target_id}" Style="{StaticResource NavigationCellText}" Margin="2,1,6,1" MouseLeftButtonDown="location_link_double_clicked"/>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <Style x:Key="SheetNumberCell" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="ContentTemplate" Value="{StaticResource SheetNumberCell.Single}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding has_multiple_sheet_numbers}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource SheetNumberCell.Multi}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SheetNameCell" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="ContentTemplate" Value="{StaticResource SheetNameCell.Single}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding has_multiple_sheet_names}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource SheetNameCell.Multi}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Pills are a fixed 19px tall and top-aligned: a tall row (wrapped comments)
         must not stretch the badge with it. Vertical padding is 0 so Height owns
         the geometry; the label centres inside. -->
    <Style x:Key="PlacementBadge" TargetType="Border">
      <Setter Property="Height" Value="19"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="Margin" Value="4,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="{DynamicResource CED.Brush.BadgeInfoBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeInfoBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On Sheet">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.StatusSuccessBackground}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.ApplyBorder}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Not on Sheet">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.StatusErrorBackground}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentRed}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="IssueBadge" TargetType="Border">
      <Setter Property="Height" Value="19"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="Margin" Value="4,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="{DynamicResource CED.Brush.StatusWarningBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.BadgeWarningBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding severity}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.StatusErrorBackground}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentRed}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Revision Cloud Manager" Style="{DynamicResource CED.Text.Title}"/>
        <TextBlock Name="DocumentText" Text="Active document: -" Style="{DynamicResource CED.Text.Secondary}" Margin="0,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Name="RefreshButton" Content="Refresh" Style="{DynamicResource CED.Button.Apply}" Width="88" Height="28" Click="refresh_clicked"/>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" Name="MainTabs" Style="{DynamicResource CED.TabControl.Base}" SelectionChanged="main_tab_changed">
      <TabItem Header="Cloud Review">
        <Grid Margin="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" BorderBrush="{DynamicResource CED.Brush.CardBorder}" BorderThickness="1" Background="{DynamicResource CED.Brush.Surface}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Filters" Style="{StaticResource ControlSectionHeader}"/>
                <TextBlock Text="Search" Style="{DynamicResource CED.Text.CaptionStrong}" Margin="0,8,0,0"/>
                <TextBox Name="SearchBox" Style="{DynamicResource CED.Input.TextBox}" Height="28" Padding="7,1" VerticalContentAlignment="Center" Margin="0,3,0,10" ToolTip="Search comments, sheets, views, revisions, and cloud IDs" TextChanged="filters_changed"/>

                <TextBlock Text="Revision" Style="{DynamicResource CED.Text.CaptionStrong}"/>
                <ComboBox Name="RevisionFilter" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" Height="25" Margin="0,3,0,9" SelectionChanged="filters_changed"/>
                <TextBlock Text="Issue status" Style="{DynamicResource CED.Text.CaptionStrong}"/>
                <ComboBox Name="IssueFilter" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" Height="25" Margin="0,3,0,9" SelectionChanged="filters_changed"/>
                <TextBlock Text="Placement" Style="{DynamicResource CED.Text.CaptionStrong}"/>
                <ComboBox Name="PlacementFilter" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" Height="25" Margin="0,3,0,9" SelectionChanged="filters_changed"/>
                <TextBlock Text="Sheet" Style="{DynamicResource CED.Text.CaptionStrong}"/>
                <ComboBox Name="SheetFilter" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" Height="25" Margin="0,3,0,9" SelectionChanged="filters_changed"/>

                <Button Content="Clear filters" Style="{DynamicResource CED.Button.Base}" Height="26" Margin="0,2,0,12" Click="clear_filters_clicked"/>

                <TextBlock Text="Columns" Style="{StaticResource ControlSectionHeader}" Margin="0,0,0,5"/>
                <!-- Rev, Sheet and View identify a row, so they are always shown and have
                     no toggle. Created / Edited / Owned by default off. -->
                <UniformGrid Columns="2" Margin="0,0,0,12">
                  <CheckBox Name="ReviewSheetNameCheck" Content="Sheet name" Tag="sheet_name" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                  <CheckBox Name="ReviewCommentsCheck" Content="Comments" Tag="comments" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                  <CheckBox Name="ReviewPlacementCheck" Content="Placement" Tag="placement" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                  <CheckBox Name="ReviewIssuesCheck" Content="Issues" Tag="issues" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                  <CheckBox Name="ReviewCreatedByCheck" Content="Created by" Tag="created_by" IsChecked="False" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                  <CheckBox Name="ReviewEditedByCheck" Content="Edited by" Tag="edited_by" IsChecked="False" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                  <CheckBox Name="ReviewOwnedByCheck" Content="Owned by" Tag="owned_by" IsChecked="False" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                  <CheckBox Name="ReviewCloudIdCheck" Content="Cloud ID" Tag="cloud_id" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Click="review_column_toggled"/>
                </UniformGrid>
                <Border Height="1" Background="{DynamicResource CED.Brush.CardBorder}" Margin="0,0,0,12"/>
                <Border Background="{DynamicResource CED.Brush.InfoPanelBackground}" BorderBrush="{DynamicResource CED.Brush.InfoPanelBorder}" BorderThickness="1" CornerRadius="4" Padding="10">
                  <StackPanel>
                    <TextBlock Name="CloudCountText" Text="0 Clouds" Style="{DynamicResource CED.Text.SectionHeader}"/>
                    <TextBlock Name="IssueCountText" Text="0 Issues" Style="{DynamicResource CED.Text.Secondary}" Margin="0,5,0,0"/>
                    <TextBlock Name="SelectedCountText" Text="0 Selected" Style="{DynamicResource CED.Text.Secondary}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="1"/>
              <RowDefinition Height="286" MinHeight="286"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource CED.Brush.DataGridBorder}" BorderThickness="1" Background="{DynamicResource CED.Brush.ListBackground}">
              <DataGrid Name="CloudGrid"
                        Style="{DynamicResource CED.DataGrid.Display.Alternating}"
                        RowStyle="{DynamicResource CED.DataGrid.Row.Display.Alternating}"
                        ColumnHeaderStyle="{DynamicResource CED.DataGrid.Header.Wrap}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CanUserReorderColumns="True"
                        CanUserSortColumns="True"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True"
                        SelectionChanged="cloud_selection_changed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Rev" Width="62" SortMemberPath="revision_sort" Binding="{Binding revision_number}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                  <DataGridTemplateColumn Header="Sheet" Width="98" SortMemberPath="sheet_sort" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <ContentControl Content="{Binding}" Style="{StaticResource SheetNumberCell}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Sheet Name" Width="1.25*" SortMemberPath="sheet_names" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <ContentControl Content="{Binding}" Style="{StaticResource SheetNameCell}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- view_display is a dash for sheeted clouds (Sheet already says where
                       it is) and target 0 renders as plain, non-navigable text. -->
                  <DataGridTemplateColumn Header="View" Width="1.15*" SortMemberPath="view_display" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <TextBlock Text="{Binding view_display}" Tag="{Binding view_display_id}" Style="{StaticResource NavigationCellText}" Margin="2,1" MouseLeftButtonDown="location_link_double_clicked"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Comments" Width="2.1*" SortMemberPath="comments" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <TextBlock Text="{Binding comments}" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Top" Margin="2,1"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Placement" Width="112" SortMemberPath="placement" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <!-- A cloud has exactly one placement, so this cell is one Border - no
                             ItemsControl/WrapPanel/container per row. Same badge, same triggers. -->
                        <Border Style="{StaticResource PlacementBadge}" Tag="{Binding placement}">
                          <TextBlock Text="{Binding placement}" Foreground="{DynamicResource CED.Brush.PrimaryText}" FontSize="10.5" VerticalAlignment="Center"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Issues" Width="1.3*" SortMemberPath="issues_text" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ItemsControl ItemsSource="{Binding issue_badges}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource IssueBadge}">
                                <TextBlock Text="{Binding text}" Foreground="{DynamicResource CED.Brush.PrimaryText}" FontSize="10.5" VerticalAlignment="Center"/>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Created by" Width="110" SortMemberPath="created_by" Binding="{Binding created_by_display}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                  <DataGridTextColumn Header="Edited by" Width="110" SortMemberPath="edited_by" Binding="{Binding edited_by_display}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                  <DataGridTextColumn Header="Owned by" Width="110" SortMemberPath="worksharing_owner" Binding="{Binding worksharing_owner_display}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                  <DataGridTextColumn Header="Cloud ID" Width="92" SortMemberPath="cloud_id" Binding="{Binding cloud_id}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource CED.Brush.CardBorder}"/>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CED.Brush.CardBorder}" BorderThickness="1" Background="{DynamicResource CED.Brush.Surface}" Padding="10,8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="22"/>
                  <RowDefinition Height="*" MinHeight="156"/>
                  <RowDefinition Height="1"/>
                  <RowDefinition Height="44"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Selected Cloud" Style="{StaticResource ControlSectionHeader}"/>

                <!-- Two aligned columns: left = Sheet / Revision / Comments, right = Cloud ID / Created by / Owned by -->
                <Grid Grid.Row="1" Margin="0,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="140"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200" MinWidth="120"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*" MinHeight="52"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- left column -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Sheet" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Name="OwnerBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="24" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Revision" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Name="SelectedRevisionBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="24" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Comments" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Top" Margin="0,8,10,0"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Name="CommentBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Margin="0,3,0,0" Padding="7,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Top" TextAlignment="Left" IsReadOnly="True" AcceptsReturn="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="comment_text_changed"/>

                  <!-- right column -->
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="Cloud ID" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Row="0" Grid.Column="4" Name="CloudIdBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="24" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True"/>

                  <TextBlock Grid.Row="1" Grid.Column="3" Text="Created by" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Row="1" Grid.Column="4" Name="CreatedByBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="24" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True"/>

                  <TextBlock Grid.Row="2" Grid.Column="3" Text="Owned by" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                  <TextBox Grid.Row="2" Grid.Column="4" Name="RevitOwnerBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="24" Margin="0,3,0,0" Padding="6,0" VerticalAlignment="Top" VerticalContentAlignment="Center" IsReadOnly="True"/>

                  <!-- Apply row lives inside columns 0-1 so the button's right edge lines up with the comment box.
                       Equal 10px margins keep the button the same distance from the comment box above and the divider below. -->
                  <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Name="CommentStateText" Text="" Style="{DynamicResource CED.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Name="ApplyCommentButton" Content="Apply Comment" Style="{DynamicResource CED.Button.Apply}" Width="120" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="False" Click="apply_comment_clicked"/>
                  </Grid>
                </Grid>

                <Border Grid.Row="2" Height="1" Background="{DynamicResource CED.Brush.CardBorder}"/>

                <Grid Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Bottom">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Review list" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Name="PreviousButton" Style="{DynamicResource CED.Button.Base}" Width="32" Height="28" Padding="0" ToolTip="Previous cloud" Click="previous_clicked">
                    <Path Data="{DynamicResource CED.Icon.Chevron.Left}" Width="10" Height="10" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                  </Button>
                  <TextBlock Grid.Column="2" Name="QueueText" Text="No visible rows" Style="{DynamicResource CED.Text.Secondary}" VerticalAlignment="Center" Margin="10,0"/>
                  <Button Grid.Column="3" Name="NextButton" Style="{DynamicResource CED.Button.Base}" Width="32" Height="28" Padding="0" ToolTip="Next cloud" Click="next_clicked">
                    <Path Data="{DynamicResource CED.Icon.Chevron.Right}" Width="10" Height="10" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                  </Button>
                  <Button Grid.Column="4" Name="ShowButton" Content="Show in Model" Style="{DynamicResource CED.Button.Primary}" Width="112" Height="28" Margin="18,0,0,0" Click="show_clicked"/>
                  <Button Grid.Column="5" Name="SelectButton" Content="Select in Model" Style="{DynamicResource CED.Button.Base}" Width="112" Height="28" Margin="8,0,0,0" Click="select_clicked"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Report Builder">
        <Grid Margin="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" BorderBrush="{DynamicResource CED.Brush.CardBorder}" BorderThickness="1" Background="{DynamicResource CED.Brush.Surface}" Padding="12,12,4,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <Grid MinWidth="382">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0  Revisions header -->
                <RowDefinition Height="145"/>    <!-- 1  revision checklist -->
                <RowDefinition Height="Auto"/>   <!-- 2  select all / clear -->
                <RowDefinition Height="Auto"/>   <!-- 3  divider -->
                <RowDefinition Height="Auto"/>   <!-- 4  Project Metadata -->
                <RowDefinition Height="Auto"/>   <!-- 5  divider -->
                <RowDefinition Height="Auto"/>   <!-- 6  Report Columns header -->
                <RowDefinition Height="220"/>    <!-- 7  report column grid -->
                <RowDefinition Height="Auto"/>   <!-- 8  export order row -->
                <RowDefinition Height="Auto"/>   <!-- 9  selected column panel -->
                <RowDefinition Height="Auto"/>   <!-- 10 divider -->
                <RowDefinition Height="Auto"/>   <!-- 11 Report Options (page + typography) -->
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Revisions" Style="{StaticResource ControlSectionHeader}" Margin="0,0,0,5"/>
              <Border Grid.Row="1" BorderBrush="{DynamicResource CED.Brush.ListBorder}" BorderThickness="1" Background="{DynamicResource CED.Brush.ListBackground}">
                <DataGrid Name="RevisionChecklist"
                          Style="{DynamicResource CED.DataGrid.Display.Alternating}"
                          RowStyle="{DynamicResource CED.DataGrid.Row.Display.Alternating}"
                          ColumnHeaderStyle="{DynamicResource CED.DataGrid.Header.Wrap}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Use" Width="44" SortMemberPath="is_selected" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox Tag="{Binding revision_id}" IsChecked="{Binding is_selected, Mode=TwoWay}" Style="{DynamicResource CED.Input.CheckBox}" HorizontalAlignment="Center" Click="report_revision_toggled"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Rev" Width="58" SortMemberPath="sequence" Binding="{Binding number}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                    <DataGridTextColumn Header="Description" Width="*" SortMemberPath="description" Binding="{Binding description}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                    <DataGridTextColumn Header="Date" Width="82" SortMemberPath="date" Binding="{Binding date}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Select all" Style="{DynamicResource CED.Button.Base}" Width="76" Height="24" Click="select_all_revisions_clicked"/>
                <Button Content="Clear" Style="{DynamicResource CED.Button.Base}" Width="76" Height="24" Margin="6,0,0,0" Click="clear_revisions_clicked"/>
              </StackPanel>

              <Border Grid.Row="3" Style="{StaticResource SectionDivider}"/>

              <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Project Metadata" Style="{StaticResource ControlSectionHeader}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Name="UseProjectValuesCheck" Content="Use project values" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Checked="project_values_toggled" Unchecked="project_values_toggled"/>
                    <CheckBox Name="IncludeLogoCheck" Content="Logo" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Margin="12,0,0,0" Click="report_preference_changed"/>
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Number" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Name="ProjectNumberBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="28" Padding="7,1" VerticalContentAlignment="Center" IsReadOnly="True" TextChanged="report_input_changed"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Client" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Name="ClientBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="28" Padding="7,1" VerticalContentAlignment="Center" IsReadOnly="True" TextChanged="report_input_changed"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Project Name" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Name="ProjectNameBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="28" Padding="7,1" VerticalContentAlignment="Center" IsReadOnly="True" TextChanged="report_input_changed"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Report Date" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="3" Grid.Column="1" Name="ReportDateBox" Style="{DynamicResource CED.Input.TextBox.ReadOnly}" Height="28" Padding="7,1" VerticalContentAlignment="Center" IsReadOnly="True" TextChanged="report_input_changed"/>
                </Grid>
              </Grid>

              <Border Grid.Row="5" Style="{StaticResource SectionDivider}"/>

              <Grid Grid.Row="6" Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Report Columns" Style="{StaticResource ControlSectionHeader}" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" Name="ShowCheckedColumnsOnlyCheck" Content="Show checked only" Style="{DynamicResource CED.Input.CheckBox}" Checked="report_column_filter_changed" Unchecked="report_column_filter_changed"/>
              </Grid>
              <Border Grid.Row="7" BorderBrush="{DynamicResource CED.Brush.ListBorder}" BorderThickness="1" Background="{DynamicResource CED.Brush.ListBackground}">
                <DataGrid Name="ReportColumnGrid"
                          Style="{DynamicResource CED.DataGrid.Display.Alternating}"
                          RowStyle="{DynamicResource CED.DataGrid.Row.Display.Alternating}"
                          ColumnHeaderStyle="{DynamicResource CED.DataGrid.Header.Wrap}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                           CanUserReorderColumns="False" CanUserSortColumns="False"
                           SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                           GridLinesVisibility="Horizontal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                           SelectionChanged="report_column_selection_changed">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Use" Width="44" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox Tag="{Binding key}" IsChecked="{Binding is_selected, Mode=TwoWay}" Style="{DynamicResource CED.Input.CheckBox}" HorizontalAlignment="Center" Click="report_column_toggled"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Column / Parameter" Width="*" Binding="{Binding label}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                    <DataGridTextColumn Header="Source" Width="96" Binding="{Binding source}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly.Alternating}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>

              <!-- Reorder: label right-justified so it stays with the controls it describes -->
              <Grid Grid.Row="8" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Reorder columns" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Style="{DynamicResource CED.Button.Base}" Width="28" Height="24" Padding="0" ToolTip="Move column up" Click="move_column_up_clicked">
                    <Path Data="{DynamicResource CED.Icon.Chevron.Up}" Width="9" Height="9" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                  </Button>
                  <Button Style="{DynamicResource CED.Button.Base}" Width="28" Height="24" Padding="0" Margin="4,0,0,0" ToolTip="Move column down" Click="move_column_down_clicked">
                    <Path Data="{DynamicResource CED.Icon.Chevron.Down}" Width="9" Height="9" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                  </Button>
                  <Button Content="Reset" Style="{DynamicResource CED.Button.Base}" Width="62" Height="24" Margin="10,0,0,0" ToolTip="Restore the default column order" Click="reset_columns_clicked"/>
                </StackPanel>
              </Grid>

              <!-- Per-column formatting, grouped so it reads as "applies to the selected column" -->
              <Border Grid.Row="9" Margin="0,8,0,0" Padding="10,8" CornerRadius="4"
                      Background="{DynamicResource CED.Brush.InfoPanelBackground}"
                      BorderBrush="{DynamicResource CED.Brush.InfoPanelBorder}" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*" MinWidth="90"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="72"/>
                  </Grid.ColumnDefinitions>

                  <!-- Group title and the column it applies to read as one left-aligned line -->
                  <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Selected column" Style="{StaticResource ControlGroupHeader}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="SelectedColumnWidthLabel" Text="Select a column" Style="{DynamicResource CED.Text.Secondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                  <Slider Grid.Row="1" Grid.Column="1" Name="SelectedColumnWidthSlider" Style="{DynamicResource CED.Input.Slider}" Minimum="0.5" Maximum="4" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="False" IsEnabled="False" VerticalAlignment="Center" ValueChanged="report_column_width_slider_changed" PreviewMouseLeftButtonUp="report_column_width_committed" LostKeyboardFocus="report_column_width_committed"/>
                  <!-- value hugs the slider; the gap before Reset belongs to the button -->
                  <TextBlock Grid.Row="1" Grid.Column="2" Name="SelectedColumnWidthText" Text="—" Style="{DynamicResource CED.Text.CaptionStrong}" TextAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  <Button Grid.Row="1" Grid.Column="3" Name="ColumnWidthResetButton" Content="Reset" Style="{DynamicResource CED.Button.Base}" Width="62" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False" Click="column_width_reset_clicked"/>

                  <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Name="SelectedColumnBoldCheck" Content="Bold values in this column" Style="{DynamicResource CED.Input.CheckBox}" IsEnabled="False" Margin="0,2,0,0" Checked="report_column_bold_toggled" Unchecked="report_column_bold_toggled"/>
                </Grid>
              </Border>

              <Border Grid.Row="10" Style="{StaticResource SectionDivider}"/>

              <!-- Report Options: page setup and typography share one 96px label column -->
              <Grid Grid.Row="11">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Report Options" Style="{StaticResource ControlSectionHeader}" Margin="0,0,0,6"/>
                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="DeduplicateCheck" Content="Deduplicate identical sheet comments" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Margin="0,0,0,4" Click="report_preference_changed"/>
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Name="ShowBlankCommentRowsCheck" Content="Show rows with blank comments" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Margin="0,0,0,6" ToolTip="Uncheck to leave clouds that have no comment out of the report" Click="report_preference_changed"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Page" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Name="PageOrientationCombo" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" Height="26" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="page_orientation_changed">
                  <ComboBoxItem Content="Landscape" IsSelected="True"/>
                  <ComboBoxItem Content="Portrait"/>
                </ComboBox>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Font" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Name="ReportFontCombo" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" Height="26" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="report_format_changed">
                  <ComboBoxItem Content="Arial" IsSelected="True"/>
                  <ComboBoxItem Content="Calibri"/>
                  <ComboBoxItem Content="Segoe UI"/>
                  <ComboBoxItem Content="Times New Roman"/>
                </ComboBox>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Table text" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Name="ReportTableFontSizeCombo" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" Height="26" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="report_format_changed">
                  <ComboBoxItem Content="10 pt"/>
                  <ComboBoxItem Content="10.5 pt" IsSelected="True"/>
                  <ComboBoxItem Content="11 pt"/>
                  <ComboBoxItem Content="12 pt"/>
                </ComboBox>
              </Grid>
            </Grid>
            </ScrollViewer>
          </Border>

          <Border Grid.Column="2" BorderBrush="{DynamicResource CED.Brush.DataGridBorder}" BorderThickness="1" Background="{DynamicResource CED.Brush.WindowBackground}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Grid.Row="0" Name="PreviewHost">
                <ScrollViewer Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CED.Brush.WindowBackground}" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" SizeChanged="preview_host_size_changed">
                  <Grid Name="PreviewExtent" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border Name="PreviewScaleHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <Border.LayoutTransform>
                        <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="0.75" ScaleY="0.75"/>
                      </Border.LayoutTransform>
                      <Border Name="PreviewPageBorder" Background="White" BorderBrush="SlateGray" BorderThickness="1">
                        <DocumentPageView Name="PreviewPageView" Stretch="Fill"/>
                      </Border>
                    </Border>
                  </Grid>
                </ScrollViewer>

                <!-- Warning toast: floats over the top of the preview when any cloud in the
                     selected revisions still has an unresolved issue. Dismissible, and it
                     returns if the revision selection or the issue count changes. -->
                <Border Name="PreviewIssueToast" Visibility="Collapsed" Panel.ZIndex="10"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="16,14,16,0" MaxWidth="640" Padding="12,9" CornerRadius="4"
                        Background="{DynamicResource CED.Brush.AlertWarningBackground}"
                        BorderBrush="{DynamicResource CED.Brush.AlertWarningBorder}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{DynamicResource CED.Icon.Alert.Warning}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,9,0" Fill="{DynamicResource CED.Brush.AlertWarningText}"/>
                    <TextBlock Grid.Column="1" Name="PreviewIssueToastText" Text="" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource CED.Brush.AlertWarningText}"/>
                    <Button Grid.Column="2" Name="PreviewIssueToastClose" Style="{DynamicResource CED.Button.Base}" Width="20" Height="20" MinHeight="0" Padding="0" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="Dismiss" Click="dismiss_preview_issue_toast_clicked">
                      <Path Data="{DynamicResource CED.Icon.Close}" Width="8" Height="8" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Button>
                  </Grid>
                </Border>
              </Grid>
              <Border Grid.Row="1" BorderBrush="{DynamicResource CED.Brush.CardBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource CED.Brush.Surface}" Padding="8,6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="52"/><ColumnDefinition Width="78"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                  <Button Name="PreviewPreviousPageButton" Style="{DynamicResource CED.Button.Base}" Width="32" Height="26" Padding="0" ToolTip="Previous page" Click="preview_previous_page_clicked">
                    <Path Data="{DynamicResource CED.Icon.Chevron.Left}" Width="10" Height="10" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                  </Button>
                  <TextBlock Grid.Column="1" Name="PreviewPageText" Text="1 of 1" Style="{DynamicResource CED.Text.Secondary}" Margin="9,0" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Name="PreviewNextPageButton" Style="{DynamicResource CED.Button.Base}" Width="32" Height="26" Padding="0" ToolTip="Next page" Click="preview_next_page_clicked">
                    <Path Data="{DynamicResource CED.Icon.Chevron.Right}" Width="10" Height="10" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                  </Button>
                  <TextBlock Grid.Column="4" Text="Zoom" Style="{DynamicResource CED.Text.CaptionStrong}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <Slider Grid.Column="5" Name="PreviewZoomSlider" Style="{DynamicResource CED.Input.Slider}" Minimum="25" Maximum="400" Value="75" TickFrequency="5" ValueChanged="preview_zoom_slider_changed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="6" Name="PreviewZoomText" Text="75%" Style="{DynamicResource CED.Text.Secondary}" TextAlignment="Center" VerticalAlignment="Center"/>
                  <Button Grid.Column="7" Content="Fit Height" Style="{DynamicResource CED.Button.Base}" Width="72" Height="26" Click="preview_zoom_fit_clicked"/>
                  <Button Grid.Column="8" Content="Fit Width" Style="{DynamicResource CED.Button.Base}" Width="70" Height="26" Margin="6,0,0,0" Click="preview_zoom_fit_width_clicked"/>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Name="StatusText" Text="Ready" Style="{DynamicResource CED.Text.Secondary}" VerticalAlignment="Center"/>
      <!-- Close sits outside ExportButtons so it survives the Cloud Review tab, where
           that panel is collapsed. The divider lives inside the panel, so it disappears
           with the export buttons instead of dangling next to a lone Close. -->
      <Button Grid.Column="1" Content="Close" Style="{DynamicResource CED.Button.Base}" Width="82" Height="28" Click="close_clicked"/>
      <StackPanel Grid.Column="2" Name="ExportButtons" Orientation="Horizontal" Visibility="Collapsed">
        <Border Width="1" Margin="10,2,10,2" Background="{DynamicResource CED.Brush.SectionDivider}"/>
        <Button Content="PDF" Style="{DynamicResource CED.Button.Base}" Background="{DynamicResource CED.Brush.ButtonDefaultBackground}" Foreground="{DynamicResource CED.Brush.AccentRed}" BorderBrush="{DynamicResource CED.Brush.AccentRed}" Width="82" Height="28" Click="export_pdf_clicked"/>
        <Button Content="Excel" Style="{DynamicResource CED.Button.Apply}" Width="82" Height="28" Margin="8,0,0,0" Click="export_excel_clicked"/>
        <Button Content="Copy for Word" Style="{DynamicResource CED.Button.Primary}" Width="116" Height="28" Margin="8,0,0,0" Click="copy_word_clicked"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Grid.RowSpan="2" Name="StaleOverlay" Background="#66000000" Panel.ZIndex="50" Visibility="Collapsed"/>
    <Border Grid.Row="1" Name="StaleToast" Width="540" Margin="18,14,18,0" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="60" Visibility="Collapsed" Style="{DynamicResource CED.Alert.Warning}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Path Data="{DynamicResource CED.Icon.Alert.Warning}" Style="{DynamicResource CED.Alert.Icon.Warning}"/>
        <TextBlock Grid.Column="1" Name="StaleToastMessage" Margin="8,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Model changes were detected. Refresh Revision Manager to display current revision-cloud data." Style="{DynamicResource CED.Alert.Text.Warning}"/>
        <Button Grid.Column="2" Name="StaleRefreshButton" Content="Refresh" Style="{DynamicResource CED.Button.Apply}" Width="82" Height="26" Click="refresh_clicked"/>
      </Grid>
    </Border>
  </Grid>
</Window>
