<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CED Tool Theme"
        Width="700"
        Height="610"
        MinWidth="700"
        MinHeight="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CED.Brush.WindowBackground}"
        Foreground="{DynamicResource CED.Brush.PrimaryText}"
        FontFamily="Segoe UI">
  <Window.Resources>
    <DataTemplate x:Key="CED.Theme.OptionTemplate">
      <StackPanel>
        <TextBlock Text="{Binding Label}"
                   Style="{DynamicResource CED.Text.Body}"
                   FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}"
                   Style="{DynamicResource CED.Text.Caption}"
                   Margin="0,2,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid>
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="190"/>
    </Grid.ColumnDefinitions>

    <!-- One live swatch only. It redraws when a theme is picked at right. -->
    <Border Grid.Column="0"
            Margin="0,0,16,0"
            Padding="0"
            Background="{DynamicResource CED.Brush.Surface}"
            BorderBrush="{DynamicResource CED.Brush.CardBorder}"
            BorderThickness="1"
            CornerRadius="7">
      <ScrollViewer Style="{DynamicResource CED.ScrollViewer.Themed}"
                    Background="Transparent"
                    Padding="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,16,8,16">
          <TextBlock x:Name="PreviewTitle"
                     Text="Theme preview"
                     Style="{DynamicResource CED.Text.SectionHeader}"/>
          <TextBlock Text="A live swatch of common CED controls. Scroll to see every state."
                     Style="{DynamicResource CED.Text.Secondary}"
                     Margin="0,3,0,14"/>

          <TextBlock Text="Buttons" Style="{DynamicResource CED.Text.Body}" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,12">
            <Button Content="Primary" Style="{DynamicResource CED.Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="Secondary" Style="{DynamicResource CED.Button.Base}" Margin="0,0,8,0"/>
            <Button Content="Apply" Style="{DynamicResource CED.Button.Apply}"/>
          </StackPanel>

          <TextBlock Text="Inputs" Style="{DynamicResource CED.Text.Body}" FontWeight="SemiBold"/>
          <Grid Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition Height="30"/>
              <RowDefinition Height="30"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="34"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Text box" Grid.Row="0" VerticalAlignment="Center" Style="{DynamicResource CED.Text.Body}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="Preview text" IsReadOnly="True" Style="{DynamicResource CED.Input.TextBox}"/>
            <TextBlock Text="Picker" Grid.Row="1" VerticalAlignment="Center" Style="{DynamicResource CED.Text.Body}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}">
              <ComboBoxItem Content="Selected option"/>
              <ComboBoxItem Content="Another option"/>
            </ComboBox>
            <TextBlock Text="Filterable picker" Grid.Row="2" VerticalAlignment="Center" Style="{DynamicResource CED.Text.Body}"/>
            <ComboBox x:Name="PreviewFilterCombo"
                      Grid.Row="2"
                      Grid.Column="1"
                      Style="{DynamicResource CED.Input.ComboBox.Flat.Compact.Editable}"
                      ToolTip="Type to filter choices, or click the arrow to browse all choices."/>
            <TextBlock x:Name="PreviewFilterStatus"
                       Grid.Row="3"
                       Grid.Column="1"
                       Style="{DynamicResource CED.Text.Caption}"
                       TextWrapping="Wrap"
                       Margin="0,1,0,0"/>
            <TextBlock Text="Read Only"
                       Grid.Row="4"
                       VerticalAlignment="Center"
                       Style="{DynamicResource CED.Text.Body}"/>
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="28"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="UnlockSequenceTextBox"
                       IsReadOnly="True"
                       Style="{DynamicResource CED.Input.TextBox.ReadOnly}"/>
              <Button x:Name="StartUnlockButton"
                      Grid.Column="2"
                      Content="◇"
                      Padding="0"
                      Style="{DynamicResource CED.Button.Base}"/>
              <Button x:Name="ClearUnlockButton"
                      Grid.Column="4"
                      Height="24"
                      Padding="0"
                      Style="{DynamicResource CED.Button.IconSmall}">
                <Path Data="{DynamicResource CED.Icon.Close}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="11"
                      Height="11"
                      Stretch="Uniform"/>
              </Button>
            </Grid>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
            <CheckBox Content="Checked" IsChecked="True" Style="{DynamicResource CED.Input.CheckBox}" Margin="0,0,22,0"/>
            <RadioButton Content="Selected" GroupName="ThemePreview" IsChecked="True" Style="{DynamicResource CED.Input.RadioButton}" Margin="0,0,14,0"/>
            <RadioButton Content="Option" GroupName="ThemePreview" Style="{DynamicResource CED.Input.RadioButton}"/>
          </StackPanel>

          <Grid Margin="0,7,0,13">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Slider" Grid.Row="0" VerticalAlignment="Center" Style="{DynamicResource CED.Text.Body}"/>
            <Slider x:Name="PreviewSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="58" Style="{DynamicResource CED.Input.Slider}"/>
            <TextBlock Text="Toggle" Grid.Row="1" VerticalAlignment="Center" Style="{DynamicResource CED.Text.Body}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox IsChecked="True" Style="{DynamicResource CED.Input.ToggleSwitch}"/>
              <TextBlock Text="Enabled" Style="{DynamicResource CED.Text.Body}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{DynamicResource CED.Brush.SectionDivider}" Margin="0,0,0,12"/>

          <Grid Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Data grid" Style="{DynamicResource CED.Text.Body}" FontWeight="SemiBold"/>
            <CheckBox x:Name="PreviewAlternatingToggle"
                      Grid.Column="1"
                      Content="Alternating rows"
                      IsChecked="True"
                      Style="{DynamicResource CED.Input.CheckBox}"/>
          </Grid>
          <DataGrid x:Name="PreviewDataGrid"
                    Height="154"
                    Margin="0,6,0,13"
                    AutoGenerateColumns="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="True"
                    CanUserResizeRows="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    ColumnWidth="*"
                    MinColumnWidth="58"
                    HorizontalScrollBarVisibility="Auto"
                    Style="{DynamicResource CED.DataGrid.Display.Flat}"
                    ColumnHeaderStyle="{DynamicResource CED.DataGrid.Header.Wrap}"
                    RowStyle="{DynamicResource CED.DataGrid.RowDisabledAware}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Sample"
                                  Width="1.25*"
                                  Binding="{Binding sample}"
                                  CellStyle="{DynamicResource CED.DataGrid.Cell.Alternating}"/>
              <DataGridTextColumn Header="Read-only"
                                  Width="1.1*"
                                  Binding="{Binding value}"
                                  CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly}"/>
              <DataGridTextColumn Header="Neutral"
                                  Width="1.1*"
                                  Binding="{Binding value}"
                                  CellStyle="{DynamicResource ReadonlyCell.NeutralSelection}"/>
              <DataGridTextColumn Header="Editable"
                                  Width="1.1*"
                                  Binding="{Binding value}"
                                  CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayEditable}"/>
              <DataGridTextColumn Header="Changed"
                                  Width="1.1*"
                                  Binding="{Binding new_qty}"
                                  CellStyle="{DynamicResource NewQtyCell}"/>
              <DataGridTextColumn Header="State"
                                  Width="1.1*"
                                  Binding="{Binding state}"
                                  CellStyle="{DynamicResource NewValueCell}"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Rows exercise normal, disabled/hidden, changed, warning, and error states."
                     Style="{DynamicResource CED.Text.Caption}"
                     TextWrapping="Wrap"
                     Margin="0,-7,0,12"/>

          <TextBlock Text="Alerts" Style="{DynamicResource CED.Text.Body}" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <Border Style="{DynamicResource CED.Alert.Success}" Margin="0,3">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Data="{DynamicResource CED.Icon.Alert.Success}" Style="{DynamicResource CED.Alert.Icon.Success}"/>
              <TextBlock Grid.Column="1" Text="Success — action completed" Style="{DynamicResource CED.Alert.Text.Success}" Margin="7,0,0,0"/>
            </Grid>
          </Border>
          <Border Style="{DynamicResource CED.Alert.Info}" Margin="0,3">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Data="{DynamicResource CED.Icon.Alert.Info}" Style="{DynamicResource CED.Alert.Icon.Info}"/>
              <TextBlock Grid.Column="1" Text="Info — helpful context" Style="{DynamicResource CED.Alert.Text.Info}" Margin="7,0,0,0"/>
            </Grid>
          </Border>
          <Border Style="{DynamicResource CED.Alert.Warning}" Margin="0,3">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Data="{DynamicResource CED.Icon.Alert.Warning}" Style="{DynamicResource CED.Alert.Icon.Warning}"/>
              <TextBlock Grid.Column="1" Text="Warning — review before continuing" Style="{DynamicResource CED.Alert.Text.Warning}" Margin="7,0,0,0"/>
            </Grid>
          </Border>
          <Border Style="{DynamicResource CED.Alert.Error}" Margin="0,3,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Data="{DynamicResource CED.Icon.Alert.Error}" Style="{DynamicResource CED.Alert.Icon.Error}"/>
              <TextBlock Grid.Column="1" Text="Error — action could not finish" Style="{DynamicResource CED.Alert.Text.Error}" Margin="7,0,0,0"/>
            </Grid>
          </Border>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Select theme" Style="{DynamicResource CED.Text.SectionHeader}"/>
          <TextBlock Text="Preview changes here, then click Apply to save them for CED tools."
                   Style="{DynamicResource CED.Text.Secondary}"
                   TextWrapping="Wrap"
                   Margin="0,3,0,12"/>
      </StackPanel>

      <ListBox x:Name="ThemePicker"
               Grid.Row="1"
               Style="{DynamicResource CED.ListBox}"
               ItemTemplate="{DynamicResource CED.Theme.OptionTemplate}"/>

      <StackPanel Grid.Row="2" Margin="0,12,0,0">
        <TextBlock x:Name="CurrentThemeText"
                   Style="{DynamicResource CED.Text.Caption}"
                   TextWrapping="Wrap"/>
        <Button x:Name="ApplyButton"
                Content="Apply"
                Style="{DynamicResource CED.Button.Apply}"
                Margin="0,10,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>

  <Border x:Name="UnlockToast"
          Width="360"
          Margin="18,14,18,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Panel.ZIndex="20"
          IsHitTestVisible="False"
          Opacity="0"
          Visibility="Collapsed"
          Style="{DynamicResource CED.Alert.Success}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Path Data="{DynamicResource CED.Icon.Alert.Success}"
            Style="{DynamicResource CED.Alert.Icon.Success}"/>
      <TextBlock x:Name="UnlockToastMessage"
                 Grid.Column="1"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Style="{DynamicResource CED.Alert.Text.Success}"/>
    </Grid>
  </Border>
  </Grid>
</Window>
