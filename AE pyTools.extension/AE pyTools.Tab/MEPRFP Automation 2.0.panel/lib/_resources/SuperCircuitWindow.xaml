<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperCircuit V5 (MEPRFP 2.0)"
        Width="1320" Height="780"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top: client + scope summary -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock x:Name="HeaderLabel" FontWeight="Bold" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="Filter by keyword:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="KeywordCombo" Width="200" IsEditable="False"/>
        <Button x:Name="RefreshButton" Content="Refresh from doc" Width="140" Margin="12,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Counters + group-size color key -->
    <DockPanel Grid.Row="1" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="Color Key (group size):" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Border Background="#FFFFFFFF" BorderBrush="#FFBDBDBD" BorderThickness="1" Padding="6,2" Margin="0,0,8,0">
          <TextBlock Text="1 = No Color"/>
        </Border>
        <Border Background="#FF2E7D32" Padding="6,2" Margin="0,0,8,0">
          <TextBlock Text="2 = Green" Foreground="White"/>
        </Border>
        <Border Background="#FF1565C0" Padding="6,2" Margin="0,0,8,0">
          <TextBlock Text="3 = Blue" Foreground="White"/>
        </Border>
        <Border Background="#FF303F9F" Padding="6,2" Margin="0,0,8,0">
          <TextBlock Text="4-7 = Indigo" Foreground="White"/>
        </Border>
        <Border Background="#FFC62828" Padding="6,2">
          <TextBlock Text="8+ = Red" Foreground="White"/>
        </Border>
      </StackPanel>
      <TextBlock x:Name="SummaryLabel" Foreground="Gray" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Preview grid -->
    <DataGrid Grid.Row="2" x:Name="PreviewGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              SelectionMode="Extended"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              ColumnWidth="*"
              RowHeight="22">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding RowColorKey}" Value="green">
              <Setter Property="Background" Value="#FF2E7D32"/>
              <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RowColorKey}" Value="blue">
              <Setter Property="Background" Value="#FF1565C0"/>
              <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RowColorKey}" Value="indigo">
              <Setter Property="Background" Value="#FF303F9F"/>
              <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RowColorKey}" Value="red">
              <Setter Property="Background" Value="#FFC62828"/>
              <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Circuit Batch"
                            Binding="{Binding GroupLabel}"
                            IsReadOnly="True"
                            MinWidth="240"
                            Width="2.4*"/>
        <DataGridTemplateColumn Header="CKT_Panel_CEDT" MinWidth="140" Width="1.2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox IsEditable="True"
                        Text="{Binding PanelName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                        ItemsSource="{Binding PanelOptions}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="CKT_Circuit Number_CEDT" MinWidth="160" Width="1.2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox IsEditable="True"
                        Text="{Binding CircuitNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                        ItemsSource="{Binding CircuitOptions}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="CKT_Load Name_CEDT" MinWidth="180" Width="1.5*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox IsEditable="True"
                        Text="{Binding LoadName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                        ItemsSource="{Binding LoadOptions}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Family : Type"
                            Binding="{Binding FamilyType}"
                            IsReadOnly="True"
                            MinWidth="220"
                            Width="2.2*"/>
        <DataGridTextColumn Header="Element ID"
                            Binding="{Binding ElementIdText}"
                            IsReadOnly="True"
                            MinWidth="90"
                            Width="0.9*"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Bottom: status + buttons -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="Gray"/>
      <Button x:Name="ApplyEditsButton" Content="Apply edits" Width="140" Margin="0,0,8,0"
              ToolTip="Push your panel / circuit / load edits into the run, regrouping and re-rendering."/>
      <Button x:Name="RunButton" Content="Run circuits" Width="140" Margin="0,0,8,0"
              ToolTip="Create Revit electrical systems for every non-review row. Runs on Revit's main thread via ExternalEvent."/>
      <Button x:Name="CloseButton" Content="Close" Width="100" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
