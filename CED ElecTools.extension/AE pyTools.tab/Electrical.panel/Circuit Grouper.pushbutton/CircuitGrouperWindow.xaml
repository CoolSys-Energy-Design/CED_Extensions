<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circuit Grouper"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Panel" Color="#252526"/>
    <SolidColorBrush x:Key="Border" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="SubText" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Accent" Color="#2D8CEB"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#333337"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="Height" Value="30"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title -->
    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Circuit Grouper" FontSize="20" FontWeight="Bold"/>
      <TextBlock Foreground="{StaticResource SubText}"
                 Text="One row per circuit sets the load name (left), panel and breaker. Drag member rows onto another group to move them, or use 'New Group from Selected'. One native Revit circuit is created per group on Run."/>
    </StackPanel>

    <!-- Toolbar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="New Group from Selected" MinWidth="170" Click="new_group_clicked"/>
      <Button Content="Toggle Checked" MinWidth="120" Click="toggle_checked_clicked"/>
      <CheckBox Name="GroupBySpaceCheck" Content="Group by Space"
                VerticalAlignment="Center" Margin="16,0,0,0"
                Foreground="{StaticResource Text}"
                Checked="group_by_space_changed" Unchecked="group_by_space_changed"
                ToolTip="Group elements by the Space they occupy (a location property) instead of by a parameter"/>
      <TextBlock Text="Group by:" Margin="16,0,4,0" Foreground="{StaticResource SubText}"/>
      <ComboBox Name="GroupByCombo" Width="220" VerticalAlignment="Center"
                ItemsSource="{Binding GroupParamOptions}"
                SelectionChanged="group_param_changed"
                ToolTip="Parameter used to group elements into circuits"/>
      <TextBlock Text="Name by:" Margin="16,0,4,0" Foreground="{StaticResource SubText}"/>
      <ComboBox Name="NameByCombo" Width="220" VerticalAlignment="Center"
                ItemsSource="{Binding NameParamOptions}"
                SelectionChanged="name_param_changed"
                ToolTip="Parameter used to seed each circuit's Load Name (the name set on the created Revit circuit). Switching it re-seeds every name; you can still edit any name by hand."/>
      <TextBlock Name="SummaryText" Margin="16,0,0,0" Foreground="{StaticResource SubText}" Text="Ready"/>
    </StackPanel>

    <!-- Grid -->
    <DataGrid Grid.Row="2"
              Name="Grid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              GridLinesVisibility="Horizontal"
              RowHeaderWidth="0"
              EnableRowVirtualization="True"
              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              Background="{StaticResource Panel}"
              Foreground="{StaticResource Text}"
              BorderBrush="{StaticResource Border}"
              HorizontalGridLinesBrush="{StaticResource Border}"
              RowBackground="#2A2A2C"
              AlternatingRowBackground="#242426"
              AllowDrop="True"
              PreviewMouseLeftButtonDown="grid_mouse_down"
              MouseMove="grid_mouse_move"
              DragOver="grid_drag_over"
              Drop="grid_drop">
      <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#2D2D30"/>
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
          <Setter Property="BorderThickness" Value="0,0,1,1"/>
          <Setter Property="Padding" Value="6,4"/>
          <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
      </DataGrid.Resources>

      <DataGrid.GroupStyle>
        <!-- Outer level: status bucket (Not Ready / Ready / Already Circuited).
             DataContext = the CollectionViewGroup; Name = the bucket string,
             Items.Count = number of circuits in the bucket. -->
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <Border Background="#26262B" Padding="6,5" Margin="0,12,0,0"
                      BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Margin="6,0,0,0" Foreground="{StaticResource SubText}"
                             Text="{Binding Items.Count, StringFormat=' ({0} circuit(s))'}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!-- Inner level: one collapsible circuit. Custom GroupItem template
             (a stretching header + ItemsPresenter) instead of an Expander, so
             the header fills the full width and the '*' status column can push
             the status text to the right (under the Status column) rather than
             colliding with the 'A' amps label. GroupItem DataContext is the
             CollectionViewGroup; Name = the GroupVM. -->
        <GroupStyle>
          <GroupStyle.ContainerStyle>
            <Style TargetType="{x:Type GroupItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type GroupItem}">
                    <StackPanel Margin="0,6,0,0">
                      <Border Background="#30303A" Padding="2,3"
                              BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <!-- DataContext = the GroupVM -->
                        <Grid DataContext="{Binding Name}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>

                          <ToggleButton Grid.Column="0"
                                        x:Name="ExpandToggle"
                                        IsChecked="{Binding is_expanded, Mode=TwoWay}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource Text}"
                                        Width="20" Height="20" Padding="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        ToolTip="Expand / collapse this circuit">
                            <ToggleButton.Style>
                              <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="&#9656;"/>
                                <Style.Triggers>
                                  <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="&#9662;"/>
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </ToggleButton.Style>
                          </ToggleButton>

                          <TextBox Grid.Column="1"
                                   Text="{Binding load_name, Mode=OneWay}"
                                   ToolTip="Load name for this circuit (set on the created Revit circuit only; the members' CKT_Load Name_CEDT is never modified)"
                                   FontWeight="Bold"
                                   LostFocus="group_load_name_changed"/>

                          <TextBlock Grid.Column="2" Text="Panel:" Margin="12,0,4,0" Foreground="{StaticResource SubText}"/>
                          <ComboBox Grid.Column="3"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.PanelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Text="{Binding panel, Mode=OneWay}"
                                    SelectionChanged="group_panel_changed"
                                    LostFocus="group_panel_changed"/>

                          <TextBlock Grid.Column="4" Text="Breaker:" Margin="12,0,4,0" Foreground="{StaticResource SubText}"/>
                          <ComboBox Grid.Column="5"
                                    IsEditable="True"
                                    ItemsSource="{Binding DataContext.RatingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Text="{Binding rating, Mode=OneWay}"
                                    ToolTip="Breaker amps (number only). Enter 20, 20 A or 20A."
                                    SelectionChanged="group_rating_changed"
                                    LostFocus="group_rating_changed"
                                    GotKeyboardFocus="rating_got_focus"
                                    PreviewMouseLeftButtonDown="rating_mouse_down"/>
                          <TextBlock Grid.Column="6" Text="A" Margin="3,0,0,0" Foreground="{StaticResource SubText}"/>

                          <TextBlock Grid.Column="7"
                                     Text="&#9888;"
                                     FontWeight="Bold"
                                     FontSize="14"
                                     Foreground="#E0B020"
                                     Margin="6,0,0,0"
                                     Visibility="{Binding rating_warning_visibility}"
                                     ToolTip="{Binding rating_tooltip}"/>

                          <TextBlock Grid.Column="8"
                                     HorizontalAlignment="Right"
                                     Margin="12,0,4,0"
                                     TextWrapping="Wrap"
                                     Text="{Binding status}"
                                     Foreground="{Binding status_color}"/>
                        </Grid>
                      </Border>
                      <ItemsPresenter Visibility="{Binding IsChecked, ElementName=ExpandToggle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </DataGrid.GroupStyle>

      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="30">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding include, Mode=OneWay}"
                        IsEnabled="{Binding can_include}"
                        HorizontalAlignment="Center"
                        Checked="row_include_changed"
                        Unchecked="row_include_changed"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="Family:Type" Binding="{Binding family_type}" Width="*"/>
        <DataGridTextColumn Header="Identity Mark" Binding="{Binding identity_mark}" Width="140"/>
        <DataGridTextColumn Header="Voltage" Binding="{Binding voltage_text}" Width="80"/>
        <DataGridTextColumn Header="Poles" Binding="{Binding poles_text}" Width="60"/>
        <DataGridTextColumn Header="Elev. from Level" Binding="{Binding elevation_text}" Width="110"/>

        <DataGridTemplateColumn Header="Status" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding status}" Foreground="{Binding status_color}" TextWrapping="Wrap"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Validation -->
    <Border Grid.Row="3" Margin="0,8,0,0" Padding="8" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
      <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
        <TextBlock Name="ValidationText" TextWrapping="Wrap" Foreground="{StaticResource SubText}"
                   Text="No validation issues."/>
      </ScrollViewer>
    </Border>

    <!-- Buttons -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Run Circuiting" MinWidth="130" Style="{StaticResource AccentButton}" Click="run_clicked"/>
      <Button Content="Cancel" Click="cancel_clicked"/>
    </StackPanel>
  </Grid>
</Window>
