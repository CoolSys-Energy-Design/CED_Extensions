<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Calculation Preview"
        Height="430"
        Width="880"
        MinHeight="320"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CED.Brush.WindowBackground}">
  <Grid Margin="{DynamicResource CED.Thickness.ContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Calculation Preview"
               Style="{DynamicResource CED.Text.SectionHeader}"
               Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1"
               Text="The following circuits will have a different conduit and wire size after calculation."
               Style="{DynamicResource CED.Text.Secondary}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource CED.Brush.DataGridBorder}"
            BorderThickness="1"
            Background="{DynamicResource CED.Brush.ListBackground}">
      <DataGrid Name="PreviewList"
                Style="{DynamicResource CED.DataGrid.Display}"
                ColumnHeaderStyle="{DynamicResource HeaderWrapCenter}"
                RowStyle="{DynamicResource CED.DataGrid.Row.Display}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Panel / Circuit" Width="1.0*" Binding="{Binding circuit}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly}"/>
          <DataGridTextColumn Header="Load Name" Width="1.4*" Binding="{Binding load_name}" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly}"/>
          <DataGridTemplateColumn Header="Previous Size" Width="1.8*" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding previous_size}" TextWrapping="Wrap" Style="{DynamicResource RemarksTextCell}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="New Size" Width="1.8*" CellStyle="{DynamicResource CED.DataGrid.Cell.DisplayReadonly}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding new_size}" TextWrapping="Wrap" Style="{DynamicResource RemarksTextCell}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Style="{DynamicResource CED.Button.Base}"
              Content="Skip Calculations"
              MinWidth="116"
              Height="24"
              Foreground="{DynamicResource CED.Brush.AccentRed}"
              BorderBrush="{DynamicResource CED.Brush.AccentRed}"
              BorderThickness="2"
              Click="skip_clicked"/>
      <Border Grid.Column="2"
              Width="1"
              Height="22"
              Margin="10,0,10,0"
              Background="{DynamicResource CED.Brush.DataGridDividerStrong}"/>
      <Button Grid.Column="3"
              Style="{DynamicResource CED.Button.Base}"
              Content="Keep Existing"
              MinWidth="104"
              Height="24"
              Margin="0,0,8,0"
              Click="keep_existing_clicked"/>
      <Button Grid.Column="4"
              Style="{DynamicResource CED.Button.Apply}"
              Content="Keep New"
              MinWidth="92"
              Height="24"
              Click="keep_new_clicked"/>
    </Grid>
  </Grid>
</Window>
