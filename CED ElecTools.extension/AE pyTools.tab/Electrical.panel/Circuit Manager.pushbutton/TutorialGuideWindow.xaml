<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circuit Manager Tutorial"
        Width="400"
        MaxHeight="660"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

  <Border Margin="14"
          CornerRadius="10"
          Background="{DynamicResource CED.Brush.WindowBackground}"
          BorderBrush="{DynamicResource CED.Brush.Border}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- title bar : drag handle -->
      <Border Grid.Row="0"
              Name="TitleBar"
              CornerRadius="10,10,0,0"
              Background="{DynamicResource CED.Brush.SurfaceAlt}"
              BorderBrush="{DynamicResource CED.Brush.SectionDivider}"
              BorderThickness="0,0,0,1"
              Padding="12,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Name="TourTitleText"
                     Text="Circuit Manager - Show Me Around"
                     Style="{DynamicResource CED.Text.CaptionStrong}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1"
                     Name="StepCounterText"
                     Text="1 / 1"
                     Style="{DynamicResource CED.Text.Caption}"
                     VerticalAlignment="Center"
                     Margin="8,0,8,0"/>
          <Button Grid.Column="2"
                  Name="CloseButton"
                  Style="{DynamicResource CED.Button.IconSmall}"
                  Width="20"
                  Height="20"
                  Padding="0"
                  ToolTip="End the tour">
            <TextBlock Text="&#215;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>
        </Grid>
      </Border>

      <!-- mascot + speech bubble -->
      <Grid Grid.Row="1" Margin="12,12,12,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="92"
                Height="102"
                VerticalAlignment="Top"
                CornerRadius="8"
                Background="{DynamicResource CED.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource CED.Brush.SectionDivider}"
                BorderThickness="1">
          <Image Name="ColonelImage"
                 Source="{DynamicResource CED.Colonel.Image}"
                 Width="80"
                 Height="92"
                 Stretch="Uniform"
                 VerticalAlignment="Bottom"
                 Margin="0,4,0,0"/>
        </Border>

        <Grid Grid.Column="1" Margin="8,0,0,0">
          <!-- bubble tail -->
          <Path Data="M8,0 L0,7 L8,14 Z"
                Fill="{DynamicResource CED.Brush.Surface}"
                Stroke="{DynamicResource CED.Brush.Border}"
                StrokeThickness="1"
                Width="8"
                Height="14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,22,0,0"
                Panel.ZIndex="2"/>
          <Border Margin="7,0,0,0"
                  CornerRadius="8"
                  Background="{DynamicResource CED.Brush.Surface}"
                  BorderBrush="{DynamicResource CED.Brush.Border}"
                  BorderThickness="1"
                  Padding="10,8,10,10">
            <StackPanel>
              <TextBlock Name="StepTitleText"
                         Text="Step title"
                         Style="{DynamicResource CED.Text.SectionHeader}"
                         TextWrapping="Wrap"/>
              <TextBlock Name="StepBodyText"
                         Text="Step body"
                         Style="{DynamicResource CED.Text.Body}"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0"/>
              <Border Name="SpotlightNoteHost"
                      Margin="0,8,0,0"
                      CornerRadius="4"
                      Background="{DynamicResource CED.Brush.InfoAccentBackground}"
                      BorderBrush="{DynamicResource CED.Brush.InfoAccentBorder}"
                      BorderThickness="1"
                      Padding="6,3,6,3"
                      HorizontalAlignment="Left">
                <TextBlock Name="SpotlightNoteText"
                           Text=""
                           Style="{DynamicResource CED.Text.Caption}"
                           TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- detail bullets -->
      <ScrollViewer Grid.Row="2"
                    Name="BulletScroller"
                    Margin="12,0,12,8"
                    MaxHeight="230"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl Name="BulletList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0"
                         Width="5"
                         Height="5"
                         Margin="2,6,8,0"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource CED.Brush.Accent}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           Style="{DynamicResource CED.Text.Secondary}"
                           TextWrapping="Wrap"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- chapter + progress -->
      <Grid Grid.Row="3" Margin="12,0,12,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Name="ChapterText"
                   Text="Chapter"
                   Style="{DynamicResource CED.Text.Caption}"
                   Margin="0,0,0,4"/>
        <Border Grid.Row="1"
                Name="ProgressTrack"
                Height="4"
                CornerRadius="2"
                Background="{DynamicResource CED.Brush.SectionDivider}"
                HorizontalAlignment="Stretch">
          <Border Name="ProgressFill"
                  Height="4"
                  Width="0"
                  CornerRadius="2"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource CED.Brush.Accent}"/>
        </Border>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="4"
              CornerRadius="0,0,10,10"
              Background="{DynamicResource CED.Brush.SurfaceAlt}"
              BorderBrush="{DynamicResource CED.Brush.SectionDivider}"
              BorderThickness="0,1,0,0"
              Padding="12,8,12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0"
                    Name="JumpBox"
                    Height="24"
                    MaxWidth="170"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ToolTip="Jump to a chapter"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Name="BackButton"
                    Style="{DynamicResource CED.Button.Base}"
                    Content="Back"
                    Width="62"
                    Height="24"
                    Margin="0,0,6,0"/>
            <Button Name="NextButton"
                    Style="{DynamicResource CED.Button.Primary}"
                    Content="Next"
                    Width="72"
                    Height="24"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
