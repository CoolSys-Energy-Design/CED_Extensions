<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Circuits by Device Parameter"
        Height="720" Width="940"
        MinHeight="520" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CED.Brush.WindowBackground}"
        Foreground="{DynamicResource CED.Brush.PrimaryText}"
        Activated="window_activated"
        PreviewKeyDown="window_preview_key_down"
        PreviewMouseLeftButtonDown="window_mouse_down">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="MaxWidth" Value="420"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- GroupItem is not a DataGridRow, so its hover/selection overlay must be
         supplied locally while still using the shared CED theme brushes. -->
    <Style x:Key="CircuitGroupHeaderBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridHeaderBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridHeaderBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemHoverBackground}"/>
        </Trigger>
        <DataTrigger Binding="{Binding is_selected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding is_drag_target}" Value="True">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.InfoAccentBackground}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.InfoAccentBorder}"/>
          <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CircuitExpandHeaderStyle"
           TargetType="{x:Type DataGridColumnHeader}">
      <!-- Keep this local because the shared CED dictionaries are merged after
           WPF constructs the window. DynamicResource resolves them safely at
           runtime while preserving the standard themed header behavior. -->
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridHeaderBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridHeaderForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridHeaderBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridHeaderHoverBackground}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridHeaderPressedBackground}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CircuitGroupExpandToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Content" Value="&#9656;"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource CED.CornerRadius.Control}">
              <Grid>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Border x:Name="StateOverlay"
                        Background="Transparent"
                        CornerRadius="{DynamicResource CED.CornerRadius.Control}"
                        IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Content" Value="&#9662;"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Match the compact information control used by Wire Tools. -->
    <Style x:Key="CircuitGrouper.InfoButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="StateOverlay"
                      Background="Transparent"
                      CornerRadius="9"/>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CircuitGrouper.AlertIconButton" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="StateOverlay"
                      Background="Transparent"
                      CornerRadius="4"/>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CircuitMemberRowStyle" TargetType="DataGridRow">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridRowBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridRowForeground}"/>
      <Setter Property="FontStyle" Value="Normal"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridSelectionBackground}"/>
          <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridSelectionForeground}"/>
        </Trigger>
        <DataTrigger Binding="{Binding is_enabled}" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
          <Setter Property="FontStyle" Value="Italic"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Transparent cells let the white/halftone row state show through and
         avoid an AlternationIndex binding on every realized cell. -->
    <Style x:Key="CircuitMemberCellStyle" TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridRowForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.DataGridCellBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.DataGridSelectionBackground}"/>
          <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridSelectionForeground}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title -->
    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{DynamicResource CED.Text.Title}"
                   Text="Create Circuits by Device Parameter"/>
        <ToggleButton Name="ToolInfoButton"
                      Style="{StaticResource CircuitGrouper.InfoButton}"
                      Margin="6,1,0,0"
                      VerticalAlignment="Top"
                      Checked="tool_info_toggled"
                      Unchecked="tool_info_toggled">
          <Grid Width="14" Height="14">
            <Ellipse Fill="Transparent"
                     Stroke="{DynamicResource CED.Brush.IconMuted}"
                     StrokeThickness="1"/>
            <TextBlock Text="i"
                       Foreground="{DynamicResource CED.Brush.IconMuted}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,-1,0,0"/>
          </Grid>
        </ToggleButton>
        <Popup Name="ToolInfoPopup"
               PlacementTarget="{Binding ElementName=ToolInfoButton}"
               Placement="Right"
               HorizontalOffset="6"
               AllowsTransparency="True"
               StaysOpen="False"
               Closed="tool_info_popup_closed">
          <Border Background="{DynamicResource CED.Brush.ListItemBackground}"
                  BorderBrush="{DynamicResource CED.Brush.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="10"
                  Width="460"
                  MinHeight="54">
            <TextBlock Text="One row per circuit sets the load name (left), panel, and breaker. Drag member rows onto another group to move them, or use the selection commands. Dedicated selections create one native Revit circuit per member when Run Circuiting is clicked. Refresh re-reads current Revit device and panel data while preserving the groups and staged circuit values in this window. After Run, the window becomes read-only and shows each actual panel and circuit number; click a result icon for concise details. Right-click any column header to show or hide columns."
                       Style="{DynamicResource CED.Text.Primary}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
          </Border>
        </Popup>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
        <TextBlock Name="DocumentText"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Text="Document: -"/>
        <TextBlock Name="ScopeText"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Margin="16,0,0,0"
                   Text="Scope: model"/>
      </StackPanel>
    </StackPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{DynamicResource CED.Button.Primary}"
                Name="NewGroupButton"
                Content="New Group from Selected" MinWidth="170" Margin="0,0,4,0"
                Click="new_group_clicked"/>
        <Button Style="{DynamicResource CED.Button.Base}"
                Name="DedicatedGroupButton"
                Content="Create Dedicated" MinWidth="125" Margin="0,0,4,0"
                ToolTip="Create one dedicated circuit row for each selected element row, preserving the source group's panel, breaker, load name, and notes."
                Click="create_dedicated_clicked"/>
        <Button Style="{DynamicResource CED.Button.Base}"
                Name="BulkSetButton"
                Content="Bulk Set Selected" MinWidth="125" Margin="0,0,4,0"
                ToolTip="Set non-blank load name, panel, breaker, and circuit notes values for the selected circuit rows (group headers)."
                Click="bulk_set_selected_clicked"/>
      </StackPanel>
      <Grid Grid.Column="1" Margin="16,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="58"/>
          <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="28"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Text="Group by:" Margin="0,0,4,0"
                   VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1"
                  Style="{DynamicResource CED.Input.ComboBox.Flat}"
                  Name="GroupByCombo" VerticalAlignment="Center"
                  ItemsSource="{Binding GroupParamOptions}"
                  SelectionChanged="group_param_changed"
                  ToolTip="Group by a parameter, Space, or the concatenated Identity value"/>
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Text="Name by:" Margin="0,0,4,0"
                   VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  Style="{DynamicResource CED.Input.ComboBox.Flat}"
                  Name="NameByCombo" VerticalAlignment="Center"
                  ItemsSource="{Binding NameParamOptions}"
                  SelectionChanged="name_param_changed"
                  ToolTip="Parameter used to seed each circuit's Load Name (the name set on the created Revit circuit). Switching it re-seeds every name; you can still edit any name by hand."/>
      </Grid>
    </Grid>

    <!-- Grid -->
    <DataGrid Grid.Row="2"
              Name="Grid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              SelectionChanged="grid_selection_changed"
              GridLinesVisibility="Horizontal"
              RowHeaderWidth="0"
              CanUserResizeColumns="True"
              CanUserReorderColumns="False"
              Style="{DynamicResource CED.DataGrid.Base}"
              RowStyle="{StaticResource CircuitMemberRowStyle}"
              CellStyle="{StaticResource CircuitMemberCellStyle}"
              ColumnHeaderStyle="{DynamicResource CED.DataGrid.Header.Wrap}"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Pixel"
              VirtualizingPanel.CacheLength="2"
              VirtualizingPanel.CacheLengthUnit="Page"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              AllowDrop="True"
              PreviewMouseRightButtonDown="grid_header_right_click"
              PreviewMouseLeftButtonDown="grid_mouse_down"
              PreviewMouseLeftButtonUp="grid_mouse_up"
              MouseMove="grid_mouse_move"
              DragOver="grid_drag_over"
              Drop="grid_drop">
      <DataGrid.GroupStyle>
        <!-- One collapsible circuit group. Readiness is validation text on the
             header and validation pane, not a second visual grouping level.
             Custom GroupItem template
             (a stretching header + ItemsPresenter) instead of an Expander, so
             the header fills the full width and the status text remains
             left-aligned in its available area. GroupItem DataContext is the
             CollectionViewGroup; Name = the GroupVM. -->
        <GroupStyle>
          <GroupStyle.ContainerStyle>
            <Style TargetType="{x:Type GroupItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type GroupItem}">
                    <StackPanel Margin="0,6,0,0">
                      <Border x:Name="GroupHeaderBorder"
                              DataContext="{Binding Name}"
                              Style="{StaticResource CircuitGroupHeaderBorder}"
                              Padding="2,3"
                              PreviewMouseLeftButtonDown="group_header_mouse_down">
                        <Grid>
                          <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>

                          <ToggleButton Grid.Column="0"
                                        x:Name="ExpandToggle"
                                        IsChecked="{Binding is_expanded, Mode=TwoWay}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        ToolTip="Expand / collapse this circuit">
                            <ToggleButton.Style>
                              <Style TargetType="ToggleButton" BasedOn="{StaticResource CircuitGroupExpandToggle}"/>
                            </ToggleButton.Style>
                          </ToggleButton>

                          <TextBlock Grid.Column="1"
                                     Style="{DynamicResource CED.Text.Secondary}"
                                     Text="Load name:"
                                     VerticalAlignment="Center"
                                     Margin="8,0,4,0"/>

                          <TextBox Grid.Column="2"
                                   Style="{DynamicResource CED.Input.TextBox}"
                                   IsEnabled="{Binding is_editable}"
                                   Height="24" MinHeight="24" Padding="6,1"
                                   Text="{Binding load_name, Mode=OneWay}"
                                   ToolTip="Load name for this circuit (set on the created Revit circuit only; the members' load-name parameter is never modified)"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   LostFocus="group_load_name_changed"/>

                          <TextBlock Grid.Column="3" Style="{DynamicResource CED.Text.Secondary}"
                                     Visibility="{Binding planning_visibility}"
                                     Text="Panel:" Margin="12,0,4,0"
                                     VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="4"
                                    Style="{DynamicResource CED.Input.ComboBox.Flat.Compact.Editable}"
                                    Visibility="{Binding planning_visibility}"
                                    IsEnabled="{Binding is_editable}"
                                    ItemsSource="{Binding panel_options}"
                                     Text="{Binding panel, Mode=OneWay}"
                                     VerticalAlignment="Center"
                                     SelectionChanged="group_panel_changed"
                                     DropDownClosed="group_panel_changed"
                                     LostFocus="group_panel_changed"/>

                          <TextBlock Grid.Column="3" Grid.ColumnSpan="2"
                                     Style="{DynamicResource CED.Text.Primary}"
                                     Visibility="{Binding result_visibility}"
                                     Text="{Binding result_assignment_label}"
                                     ToolTip="{Binding result_assignment_label}"
                                     TextTrimming="CharacterEllipsis"
                                     FontWeight="SemiBold"
                                     Margin="12,0,4,0"
                                     VerticalAlignment="Center"/>

                          <TextBlock Grid.Column="5" Style="{DynamicResource CED.Text.Secondary}"
                                     Text="Breaker:" Margin="12,0,4,0"
                                     VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="6"
                                    Style="{DynamicResource CED.Input.ComboBox.Flat.Compact.Editable}"
                                    IsEnabled="{Binding is_editable}"
                                    ItemsSource="{Binding DataContext.RatingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Text="{Binding rating, Mode=OneWay}"
                                     ToolTip="Breaker amps (number only). Enter 20, 20 A or 20A."
                                     VerticalAlignment="Center"
                                     SelectionChanged="group_rating_changed"
                                     DropDownClosed="group_rating_changed"
                                     LostFocus="group_rating_changed"
                                     GotKeyboardFocus="rating_got_focus"
                                     PreviewMouseLeftButtonDown="rating_mouse_down"/>
                          <TextBlock Grid.Column="7" Style="{DynamicResource CED.Text.Secondary}"
                                     Text="A" Margin="3,0,0,0"
                                     VerticalAlignment="Center"/>

                          <TextBlock Grid.Column="8" Style="{DynamicResource CED.Text.Secondary}"
                                     Text="Schedule notes:" Margin="12,0,4,0"
                                     VerticalAlignment="Center"/>
                          <TextBox Grid.Column="9"
                                   Style="{DynamicResource CED.Input.TextBox}"
                                   IsEnabled="{Binding is_editable}"
                                   Height="24" MinHeight="24" Padding="6,1"
                                   Text="{Binding schedule_notes, Mode=OneWay}"
                                   ToolTip="Schedule circuit notes set on the created native Revit circuit"
                                   VerticalAlignment="Center"
                                   LostFocus="group_schedule_notes_changed"/>

                          <Button Grid.Column="10" Grid.ColumnSpan="2"
                                  Content="{Binding status_icon}"
                                  Style="{StaticResource CircuitGrouper.AlertIconButton}"
                                  Margin="8,0,4,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding status_icon_color}"
                                  Visibility="{Binding rating_warning_visibility}"
                                  ToolTip="Click to view circuit status"
                                  Click="group_status_clicked"/>
                        </Grid>
                      </Border>
                        <ItemsPresenter Visibility="{Binding IsChecked, ElementName=ExpandToggle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </DataGrid.GroupStyle>

      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="40" MinWidth="40" MaxWidth="40"
                                CanUserResize="False"
                                HeaderStyle="{StaticResource CircuitExpandHeaderStyle}">
          <DataGridTemplateColumn.HeaderTemplate>
            <DataTemplate>
              <Button Content="&#8597;"
                      Style="{DynamicResource CED.Button.IconSmall}"
                      Width="28" Height="28" MinWidth="0" MinHeight="0"
                      Padding="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ToolTip="Expand or collapse all groups"
                      Click="expand_collapse_all_clicked"/>
            </DataTemplate>
          </DataGridTemplateColumn.HeaderTemplate>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox Style="{DynamicResource CED.Input.CheckBox}"
                        IsChecked="{Binding include, Mode=OneWay}"
                        IsEnabled="{Binding can_edit}"
                        HorizontalAlignment="Center"
                        Checked="row_include_changed"
                        Unchecked="row_include_changed"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="Family / Type" Binding="{Binding family_type}" Width="270" MinWidth="120" CanUserResize="True"/>
        <DataGridTextColumn Header="Identity Mark" Binding="{Binding identity_mark}" Width="80" MinWidth="80" CanUserResize="True"/>
        <DataGridTextColumn Header="Group by Value"
                            Binding="{Binding group_value}" Width="90" MinWidth="90" CanUserResize="True"/>
        <DataGridTextColumn Header="Voltage" Binding="{Binding voltage_text}" Width="60" MinWidth="60" CanUserResize="True"/>
        <DataGridTextColumn Header="Poles" Binding="{Binding poles_text}" Width="50" MinWidth="50" CanUserResize="True"/>
        <DataGridTextColumn Header="Space" Binding="{Binding space}" Width="80" MinWidth="80" CanUserResize="True"/>
        <DataGridTextColumn Header="Level" Binding="{Binding level}" Width="60" MinWidth="60" CanUserResize="True"/>
        <DataGridTextColumn Header="Elev. from Level" Binding="{Binding elevation_text}" Width="80" MinWidth="80" CanUserResize="True"/>

        <DataGridTemplateColumn Header="Status" Width="100" MinWidth="100" CanUserResize="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding status}"
                         Foreground="{Binding status_color}"
                         TextWrapping="Wrap"
                         TextAlignment="Left"
                         HorizontalAlignment="Left"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Popup Name="CircuitStatusPopup"
           Placement="Right"
           HorizontalOffset="6"
           AllowsTransparency="True"
           StaysOpen="False">
      <Border Background="{DynamicResource CED.Brush.ListItemBackground}"
              BorderBrush="{DynamicResource CED.Brush.CardBorder}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10"
              Width="340"
              MinHeight="48">
        <TextBlock Name="CircuitStatusPopupText"
                   Style="{DynamicResource CED.Text.Primary}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
      </Border>
    </Popup>

    <!-- Preloaded with the main window so Bulk Set opens immediately instead
         of constructing and theming another WPF window on every click. -->
    <Popup Name="BulkValuesPopup"
           PlacementTarget="{Binding ElementName=BulkSetButton}"
           Placement="Bottom"
           VerticalOffset="4"
           AllowsTransparency="True"
           StaysOpen="False"
           Closed="bulk_popup_closed">
      <Border Background="{DynamicResource CED.Brush.ListItemBackground}"
              BorderBrush="{DynamicResource CED.Brush.CardBorder}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12"
              Width="430">
        <StackPanel>
          <TextBlock Text="Bulk Set Selected Circuit Values"
                     Style="{DynamicResource CED.Text.SectionHeader}"/>
          <TextBlock Text="Leave a field blank to keep each selected circuit's current value."
                     Style="{DynamicResource CED.Text.Secondary}"
                     TextWrapping="Wrap"
                     Margin="0,3,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="92"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Load name:"
                       Style="{DynamicResource CED.Text.Secondary}"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="BulkPopupLoadName"
                     Height="28" Style="{DynamicResource CED.Input.TextBox}"
                     VerticalContentAlignment="Center"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Name="BulkPopupIncrement"
                      Content="Append an incrementing number"
                      Style="{DynamicResource CED.Input.CheckBox}"
                      Margin="0,4,0,8"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Panel:"
                       Style="{DynamicResource CED.Text.Secondary}"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Name="BulkPopupPanel"
                      Height="28"
                      Style="{DynamicResource CED.Input.ComboBox.Flat.Compact.Editable}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Breaker:"
                       Style="{DynamicResource CED.Text.Secondary}"
                       VerticalAlignment="Center" Margin="0,8,0,0"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Name="BulkPopupRating"
                      Height="28" Margin="0,8,0,0"
                      Style="{DynamicResource CED.Input.ComboBox.Flat.Compact.Editable}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Circuit notes:"
                       Style="{DynamicResource CED.Text.Secondary}"
                       VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox Grid.Row="4" Grid.Column="1" Name="BulkPopupNotes"
                     Height="28" Margin="0,8,0,0"
                     Style="{DynamicResource CED.Input.TextBox}"
                     VerticalContentAlignment="Center"/>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset" MinWidth="70"
                    Style="{DynamicResource CED.Button.Base}"
                    Click="bulk_popup_reset_clicked"/>
            <Button Content="Cancel" MinWidth="70" Margin="4,0,0,0"
                    Style="{DynamicResource CED.Button.Base}"
                    Click="bulk_popup_cancel_clicked"/>
            <Button Content="Apply" MinWidth="70" Margin="4,0,0,0"
                    Style="{DynamicResource CED.Button.Apply}"
                    Click="bulk_popup_apply_clicked"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Validation -->
    <Border Grid.Row="3" Margin="0,8,0,0" Padding="8"
            Background="{DynamicResource CED.Brush.ListBackground}"
            BorderBrush="{DynamicResource CED.Brush.Border}" BorderThickness="1">
      <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
        <TextBlock Name="ValidationText" Style="{DynamicResource CED.Text.Secondary}"
                   TextWrapping="Wrap"
                   Text="No validation issues."/>
      </ScrollViewer>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Button Name="SelectDeviceButton" Content="Select Device" MinWidth="88" Height="28"
                  Style="{DynamicResource CED.Button.Base}"
                  ToolTip="Select the chosen device rows in Revit"
                  Click="select_device_clicked"/>
          <Button Name="ShowDeviceButton" Content="Show Device" MinWidth="88" Height="28" Margin="4,0,0,0"
                  Style="{DynamicResource CED.Button.Base}"
                  ToolTip="Zoom to the chosen device rows in Revit"
                  Click="show_device_clicked"/>
          <Button Name="SelectGroupButton" Content="Select Group" MinWidth="88" Height="28" Margin="8,0,0,0"
                  Style="{DynamicResource CED.Button.Base}"
                  ToolTip="Select every device in the chosen circuit group(s); a selected device row uses its whole group"
                  Click="select_group_clicked"/>
          <Button Name="ShowGroupButton" Content="Show Group" MinWidth="88" Height="28" Margin="4,0,0,0"
                  Style="{DynamicResource CED.Button.Base}"
                  ToolTip="Zoom to every device in the chosen circuit group(s); a selected device row uses its whole group"
                  Click="show_group_clicked"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock Name="GridSelectionText"
                     Style="{DynamicResource CED.Text.Secondary}"
                     HorizontalAlignment="Left"
                     Text="0 element row(s) selected"/>
          <TextBlock Name="GroupSelectionText"
                     Style="{DynamicResource CED.Text.Secondary}"
                     Margin="14,0,0,0"
                     HorizontalAlignment="Left"
                     Text="0 circuit row(s) selected"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1"
              Margin="24,0,0,0"
              Padding="16,0,0,0"
              BorderBrush="{DynamicResource CED.Brush.Border}"
              BorderThickness="1,0,0,0"
              VerticalAlignment="Stretch">
        <StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Name="SummaryText"
                       Style="{DynamicResource CED.Text.Secondary}"
                       VerticalAlignment="Center"
                       Text="No circuits"/>
          </StackPanel>
          <TextBlock Name="ActionStatusText"
                     Style="{DynamicResource CED.Text.Secondary}"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap"
                     Text="No action in progress."/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Name="RefreshButton" Content="Refresh" Height="28" Style="{DynamicResource CED.Button.Base}"
                ToolTip="Re-read device parameters, circuit status, panels, and grouping options for the displayed document and original scope. The grid is rebuilt from current model data."
                Click="refresh_clicked"/>
        <Button Content="Close" Height="28" Style="{DynamicResource CED.Button.Base}"
                Margin="4,0,0,0"
                Click="cancel_clicked"/>
        <Button Name="RunButton" Content="Run Circuiting" MinWidth="130" Height="28"
                Style="{DynamicResource CED.Button.Apply}"
                Margin="4,0,0,0" Click="run_clicked"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
