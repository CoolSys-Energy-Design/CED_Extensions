<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Set Selected Circuit Values"
        Height="380" Width="620"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CED.Brush.WindowBackground}">
  <Window.Resources>
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="MaxWidth" Value="420"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="{DynamicResource CED.Thickness.ContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Style="{DynamicResource CED.Text.Title}"
                 Text="Bulk Set Selected Circuit Values"/>
      <TextBlock Margin="0,4,0,0"
                 Style="{DynamicResource CED.Text.Secondary}"
                 Text="Leave a field blank to keep each selected group's current value."
                 TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1"
            BorderBrush="{DynamicResource CED.Brush.CardBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CED.CornerRadius.Panel}"
            Background="{DynamicResource CED.Brush.InfoPanelBackground}"
            Padding="14"
            Margin="0,0,0,12">
      <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="BulkLabelColumn"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Text="Load name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="2" Name="BulkLoadNameTextBox"
                 Height="28"
                 Style="{DynamicResource CED.Input.TextBox}"
                 VerticalContentAlignment="Center"
                 ToolTip="Optional load name. When increment is checked, a number is appended for each selected group."/>
        <CheckBox Grid.Row="1" Grid.Column="2" Name="BulkIncrementCheck"
                  Style="{DynamicResource CED.Input.CheckBox}"
                  Content="Append an incrementing number to load names"
                  Margin="0,5,0,10"
                  ToolTip="When enabled, selected groups receive the load name followed by 1, 2, 3, and so on."/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Text="Panel:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="2" Name="BulkPanelCombo"
                  Style="{DynamicResource CED.Input.ComboBox.Flat.Compact.Editable}"
                  IsEditable="True" ItemsSource="{Binding PanelOptions}"
                  Width="220" Height="28" HorizontalAlignment="Left"
                  ToolTip="Optional panel. It is checked against each selected group's voltage and pole count; incompatible choices are cleared."/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Text="Breaker:" VerticalAlignment="Center"
                   Margin="0,10,0,0"/>
        <ComboBox Grid.Row="3" Grid.Column="2" Name="BulkRatingCombo"
                  Style="{DynamicResource CED.Input.ComboBox.Flat.Compact.Editable}"
                  IsEditable="True" ItemsSource="{Binding RatingOptions}"
                  Width="130" Height="28" HorizontalAlignment="Left"
                  Margin="0,10,0,0"
                  ToolTip="Optional breaker rating. Enter a number such as 20, 20A, or 20 A."/>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Style="{DynamicResource CED.Text.Secondary}"
                   Text="Circuit notes:" VerticalAlignment="Center"
                   Margin="0,10,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="2" Name="BulkNotesTextBox"
                 Height="28" HorizontalAlignment="Stretch"
                 Margin="0,10,0,0"
                 Style="{DynamicResource CED.Input.TextBox}"
                 VerticalContentAlignment="Center"
                 ToolTip="Optional schedule or circuit notes written to each selected circuit."/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Name="BulkResetButton" Content="Reset"
                Style="{DynamicResource CED.Button.Base}"
                MinWidth="70" Click="reset_clicked"/>
        <Button Name="BulkCancelButton" Content="Cancel"
                Style="{DynamicResource CED.Button.Base}"
                MinWidth="70" Margin="4,0,0,0" IsCancel="True"
                Click="cancel_clicked"/>
        <Button Name="BulkApplyButton" Content="Apply"
                Style="{DynamicResource CED.Button.Apply}"
                MinWidth="70" Margin="4,0,0,0" IsDefault="True"
                Click="apply_clicked"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
