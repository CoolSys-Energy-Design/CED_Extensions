<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wire Tools"
        Width="500"
        Height="820"
        MinWidth="440"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource CED.Brush.WindowBackground}"
        Foreground="{DynamicResource CED.Brush.PrimaryText}"
        Closing="window_closing"
        PreviewKeyDown="window_preview_key_down"
        Focusable="True">
  <Window.Resources>
    <Style x:Key="WireTools.Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="WireTools.Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="WireTools.SmoothTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="WireTools.SmoothSectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="WireTools.InputText" TargetType="TextBox">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource CED.Brush.SearchBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                <Border x:Name="InputStateOverlay"
                        Background="Transparent"
                        CornerRadius="4"
                        IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                  <Condition Binding="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                  <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
                <Setter TargetName="InputStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                  <Condition Binding="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                  <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
                <Setter TargetName="InputStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{DynamicResource CED.Brush.InfoPanelBackground}"/>
          <Setter Property="Foreground" Value="{DynamicResource CED.Brush.DataGridReadOnlyForeground}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.InfoPanelBorder}"/>
          <Setter Property="Opacity" Value="0.55"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WireTools.NumericText" TargetType="TextBox" BasedOn="{StaticResource WireTools.InputText}">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="WireTools.CircleToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource CED.Brush.ButtonDefaultBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Foreground" Value="{DynamicResource CED.Brush.Accent}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Ellipse x:Name="ToggleSurface"
                       Fill="{TemplateBinding Background}"
                       Stroke="{TemplateBinding BorderBrush}"
                       StrokeThickness="1.5"
                       SnapsToDevicePixels="True"/>
              <Ellipse x:Name="StateOverlay"
                       Fill="Transparent"/>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateOverlay" Property="Fill" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateOverlay" Property="Fill" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleSurface" Property="Stroke" Value="{DynamicResource CED.Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WireTools.InfoButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="StateOverlay"
                      Background="Transparent"
                      CornerRadius="9"/>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="{DynamicResource CED.Thickness.ContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0"
                 Text="Wire Tools"
                 Style="{StaticResource WireTools.SmoothTitle}"/>
      <TextBlock Name="TargetViewText"
                 Grid.Row="1"
                 Text="Target View: (none)"
                 HorizontalAlignment="Right"
                 Style="{DynamicResource CED.Text.Secondary}"
                 FontSize="11"
                 Margin="0,0,0,8"/>
    </Grid>

    <Border Grid.Row="1"
            BorderBrush="{DynamicResource CED.Brush.ListBorder}"
            BorderThickness="1"
            Background="{DynamicResource CED.Brush.ListBackground}"
            CornerRadius="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False"
                    Padding="10">
        <StackPanel>
          <Border Style="{StaticResource WireTools.Card}">
            <StackPanel>
              <TextBlock Text="Wiring Scheme"
                         Style="{StaticResource WireTools.SmoothSectionHeader}"
                         Margin="0,0,0,6"/>
              <ComboBox Name="SchemeCombo"
                        HorizontalAlignment="Stretch"
                        Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}"
                        SelectionChanged="scheme_changed">
                <ComboBoxItem Tag="wire_by_circuit" Content="Wire by Circuit"/>
                <ComboBoxItem Tag="interconnect" Content="Interconnect"/>
                <ComboBoxItem Tag="individual_homerun" Content="Individual Homeruns"/>
                <ComboBoxItem Tag="wire_to_node" Content="Wire to Node"/>
              </ComboBox>
              <TextBlock Name="SchemeInstructionsText"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0"
                         Style="{DynamicResource CED.Text.Secondary}"/>
            </StackPanel>
          </Border>

          <Border Name="NodeGroup"
                  Style="{StaticResource WireTools.Card}"
                  Visibility="Collapsed">
            <StackPanel>
              <StackPanel Name="NodeSelectionPanel">
                <StackPanel Orientation="Horizontal">
                  <Button Name="SelectNodeButton"
                          Content="Select Node"
                          Style="{DynamicResource CED.Button.Primary}"
                          Width="100"
                          Height="28"
                          Margin="0,0,6,0"
                          Click="select_node_clicked"/>
                  <Button Name="ClearNodeButton"
                          Content="Clear Node"
                          Style="{DynamicResource CED.Button.Base}"
                          Width="92"
                          Height="28"
                          Click="clear_node_clicked"/>
                </StackPanel>
                <TextBlock Name="NodeInfoText"
                           Text="No node selected."
                           TextWrapping="Wrap"
                           Style="{DynamicResource CED.Text.Secondary}"
                           Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Name="InterconnectScopePanel"
                          Visibility="Collapsed"
                          Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Scope" Style="{StaticResource WireTools.Label}"/>
                  <ComboBox Name="InterconnectScopeCombo"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}"
                            SelectionChanged="option_changed">
                    <ComboBoxItem Tag="selected_circuits" Content="Full Circuits"/>
                    <ComboBoxItem Tag="selected_only" Content="Selected Only"/>
                  </ComboBox>
                </Grid>
                <TextBlock Text="Full Circuits includes all devices on the underlying circuits. Selected Only includes only the selected devices."
                           TextWrapping="Wrap"
                           Style="{DynamicResource CED.Text.Secondary}"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource WireTools.Card}">
            <StackPanel>
              <TextBlock Text="Device Selection"
                         Style="{StaticResource WireTools.SmoothSectionHeader}"
                         Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <Button Name="SelectDevicesButton"
                        Content="Select Devices"
                        Style="{DynamicResource CED.Button.Primary}"
                        Width="108"
                        Height="28"
                        Margin="0,0,6,0"
                        Click="select_devices_clicked"/>
                <Button Name="UseCurrentButton"
                        Content="Use Current Selection"
                        Style="{DynamicResource CED.Button.Base}"
                        Width="150"
                        Height="28"
                        Margin="0,0,6,0"
                        Click="use_current_clicked"/>
                <Button Name="ClearDevicesButton"
                        Content="Clear"
                        Style="{DynamicResource CED.Button.Base}"
                        Width="62"
                        Height="28"
                         Click="clear_devices_clicked"/>
              </StackPanel>
              <Grid Name="SystemTypePanel"
                    Visibility="Collapsed"
                    Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="108"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="System Type"
                           Style="{StaticResource WireTools.Label}"/>
                <ComboBox Name="SystemTypeCombo"
                          Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          DisplayMemberPath="label"
                          Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}"
                          SelectionChanged="system_type_changed"/>
              </Grid>
              <TextBlock Name="DeviceCountText"
                         Text="Selected: 0 | Valid: 0 | Invalid: 0"
                         Style="{DynamicResource CED.Text.Primary}"
                         Margin="0,5,0,0"/>
              <TextBlock Name="DeviceStatusText"
                         Text="No devices selected."
                         TextWrapping="Wrap"
                         Style="{DynamicResource CED.Text.Secondary}"
                         Margin="0,2,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource WireTools.Card}">
            <StackPanel>
              <TextBlock Text="Wire Settings"
                         Style="{StaticResource WireTools.SmoothSectionHeader}"
                         Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="108"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wire Type" Style="{StaticResource WireTools.Label}"/>
                <ComboBox Name="WireTypeCombo" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="label" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" SelectionChanged="option_changed"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Branch Wiring" Style="{StaticResource WireTools.Label}"/>
                <Grid Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <RadioButton Name="BranchArcRadio"
                               Grid.Column="0"
                               Content="Arc"
                               GroupName="BranchWiringType"
                               Style="{DynamicResource CED.Input.RadioButton}"
                               Margin="0"
                               Checked="option_changed"/>
                  <RadioButton Name="BranchChamferRadio"
                               Grid.Column="1"
                               Content="Chamfer"
                               GroupName="BranchWiringType"
                               IsChecked="True"
                               Style="{DynamicResource CED.Input.RadioButton}"
                               Margin="-8,0,0,0"
                               Checked="option_changed"/>
                </Grid>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Homerun Wiring" Style="{StaticResource WireTools.Label}"/>
                <Grid Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <RadioButton Name="HomerunArcRadio"
                               Grid.Column="0"
                               Content="Arc"
                               GroupName="HomerunWiringType"
                               IsChecked="True"
                               Style="{DynamicResource CED.Input.RadioButton}"
                               Margin="0"
                               Checked="option_changed"/>
                  <RadioButton Name="HomerunChamferRadio"
                               Grid.Column="1"
                               Content="Chamfer"
                               GroupName="HomerunWiringType"
                               Style="{DynamicResource CED.Input.RadioButton}"
                               Margin="-8,0,0,0"
                               Checked="option_changed"/>
                </Grid>
                <CheckBox Name="SkipSingleDeviceToggle" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Content="Skip Single-Device Circuits" Style="{DynamicResource CED.Input.CheckBox}" Checked="option_changed" Unchecked="option_changed"/>
                <CheckBox Name="RedrawExistingToggle" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Content="Redraw Active-View Wires Connected to Selected Devices" Style="{DynamicResource CED.Input.CheckBox}" Checked="option_changed" Unchecked="option_changed"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Name="HomerunSettingsGroup" Style="{StaticResource WireTools.Card}">
            <StackPanel>
              <TextBlock Text="Home Run Settings" Style="{StaticResource WireTools.SmoothSectionHeader}" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="108"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Direction" Style="{StaticResource WireTools.Label}"/>
                  <ToggleButton Name="DirectionInfoButton"
                                Style="{StaticResource WireTools.InfoButton}"
                                Checked="direction_info_toggled"
                                Unchecked="direction_info_toggled"
                                ToolTipService.InitialShowDelay="600">
                    <Grid Width="14" Height="14">
                      <Ellipse Fill="Transparent"
                               Stroke="{DynamicResource CED.Brush.IconMuted}"
                               StrokeThickness="1"/>
                      <TextBlock Text="i"
                                 Foreground="{DynamicResource CED.Brush.IconMuted}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="0,-1,0,0"/>
                    </Grid>
                    <ToggleButton.ToolTip>
                      <ToolTip Width="250" MinHeight="54" Padding="8">
                        <TextBlock Text="Toward Panel points the homerun toward its circuit panel. Device Facing uses the selected device’s facing direction."
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                      </ToolTip>
                    </ToggleButton.ToolTip>
                  </ToggleButton>
                </StackPanel>
                <Grid Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <RadioButton Name="HomerunPanelDirectionRadio"
                               Grid.Column="0"
                               Content="Toward Panel"
                               GroupName="HomerunDirection"
                               IsChecked="True"
                               Style="{DynamicResource CED.Input.RadioButton}"
                               Margin="0"
                               Checked="option_changed"/>
                  <RadioButton Name="HomerunDeviceFacingRadio"
                               Grid.Column="1"
                               Content="Device Facing"
                               GroupName="HomerunDirection"
                               Style="{DynamicResource CED.Input.RadioButton}"
                               Margin="8,0,0,0"
                               Checked="option_changed"/>
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Homerun Length" Style="{StaticResource WireTools.Label}"/>
                 <TextBox Name="HomerunLengthText" Grid.Row="2" Grid.Column="2" Width="82" HorizontalAlignment="Left" Style="{StaticResource WireTools.NumericText}" GotKeyboardFocus="numeric_input_got_focus" PreviewMouseLeftButtonDown="numeric_input_mouse_down" PreviewTextInput="numeric_preview_text_input" LostFocus="numeric_input_lost_focus"/>
                 <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bend Offset" Style="{StaticResource WireTools.Label}"/>
                   <ToggleButton Name="BendInfoButton"
                                 Style="{StaticResource WireTools.InfoButton}"
                                 Checked="bend_info_toggled"
                                 Unchecked="bend_info_toggled"
                                 ToolTipService.InitialShowDelay="600">
                     <Grid Width="14" Height="14">
                       <Ellipse Fill="Transparent"
                                Stroke="{DynamicResource CED.Brush.IconMuted}"
                                StrokeThickness="1"/>
                       <TextBlock Text="i"
                                  Foreground="{DynamicResource CED.Brush.IconMuted}"
                                  FontSize="10"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="0,-1,0,0"/>
                     </Grid>
                     <ToggleButton.ToolTip>
                        <ToolTip Width="250" MinHeight="54" Padding="8">
                          <TextBlock Text="Moves the vertex point to increase arc amount. Negative values reverse the direction. 0 produces a straight homerun."
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"/>
                       </ToolTip>
                     </ToggleButton.ToolTip>
                   </ToggleButton>
                 </StackPanel>
                 <TextBox Name="BendOffsetText" Grid.Row="4" Grid.Column="2" Width="82" HorizontalAlignment="Left" Style="{StaticResource WireTools.NumericText}" GotKeyboardFocus="numeric_input_got_focus" PreviewMouseLeftButtonDown="numeric_input_mouse_down" PreviewTextInput="numeric_preview_text_input" LostFocus="numeric_input_lost_focus"/>
                  <Popup Name="BendInfoPopup"
                        PlacementTarget="{Binding ElementName=BendInfoButton}"
                        Placement="Right"
                        HorizontalOffset="6"
                        AllowsTransparency="True"
                        StaysOpen="False"
                        Closed="bend_info_popup_closed">
                   <Border Background="{DynamicResource CED.Brush.ListItemBackground}"
                           BorderBrush="{DynamicResource CED.Brush.CardBorder}"
                           BorderThickness="1"
                           CornerRadius="4"
                           Padding="8"
                           Width="220"
                           MinHeight="54">
                      <TextBlock Text="Moves the vertex point to increase arc amount. Negative values reverse the direction. 0 produces a straight homerun."
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
                   </Border>
                  </Popup>
                  <Popup Name="DirectionInfoPopup"
                         PlacementTarget="{Binding ElementName=DirectionInfoButton}"
                         Placement="Right"
                         HorizontalOffset="6"
                         AllowsTransparency="True"
                         StaysOpen="False"
                         Closed="direction_info_popup_closed">
                    <Border Background="{DynamicResource CED.Brush.ListItemBackground}"
                            BorderBrush="{DynamicResource CED.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Width="250"
                            MinHeight="54">
                      <TextBlock Text="Toward Panel points the homerun toward its circuit panel. Device Facing uses the selected device’s facing direction."
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </Popup>
               </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource WireTools.Card}">
            <StackPanel>
               <StackPanel Orientation="Horizontal" Height="22">
                  <ToggleButton Name="HomerunTaggingToggle"
                                Style="{StaticResource WireTools.CircleToggle}"
                                VerticalAlignment="Center"
                                IsChecked="False"
                              Checked="tagging_expander_changed"
                              Unchecked="tagging_expander_changed">
                  <Path Name="HomerunTaggingIcon"
                        Data="M1,1 L6,4 L1,7 Z"
                        Width="7"
                        Height="8"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource CED.Brush.IconMuted}"
                        RenderTransformOrigin="0.5,0.5">
                    <Path.Style>
                      <Style TargetType="Path">
                        <Setter Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="0"/>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsChecked, ElementName=HomerunTaggingToggle}" Value="True">
                            <Setter Property="RenderTransform">
                              <Setter.Value>
                                <RotateTransform Angle="90"/>
                              </Setter.Value>
                            </Setter>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                </ToggleButton>
                 <TextBlock Text="Homerun Tagging"
                            Style="{StaticResource WireTools.SmoothSectionHeader}"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0"/>
              </StackPanel>
              <StackPanel Name="HomerunTaggingPanel"
                          Visibility="Collapsed"
                          Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button Name="SelectHomerunsButton" Content="Select Homeruns" Style="{DynamicResource CED.Button.Primary}" Width="112" Height="28" Margin="0,0,6,0" Click="select_homeruns_clicked"/>
                  <Button Name="ClearHomerunsButton" Content="Clear" Style="{DynamicResource CED.Button.Base}" Width="62" Height="28" Click="clear_homeruns_clicked"/>
                </StackPanel>
                <TextBlock Name="HomerunCountText" Text="Selected homeruns: 0" Style="{DynamicResource CED.Text.Primary}" Margin="0,5,0,0"/>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Tag Type" Style="{StaticResource WireTools.Label}"/>
                  <ComboBox Name="TagTypeCombo" Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="label" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" SelectionChanged="option_changed"/>
                </Grid>
                 <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Existing Tags" Style="{StaticResource WireTools.Label}"/>
                  <ComboBox Name="ExistingTagBehaviorCombo" Grid.Column="2" HorizontalAlignment="Stretch" Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" SelectionChanged="option_changed">
                    <ComboBoxItem Tag="skip_existing" Content="Skip already tagged"/>
                    <ComboBoxItem Tag="replace_existing" Content="Replace existing tags"/>
                   </ComboBox>
                 </Grid>
                  <CheckBox Name="AddLeadersToggle" Content="Add Leaders" Style="{DynamicResource CED.Input.CheckBox}" IsChecked="True" Margin="0,6,0,0" Checked="option_changed" Unchecked="option_changed"/>
                 <Button Name="TagHomerunsButton" Content="Tag Homeruns" Style="{DynamicResource CED.Button.Apply}" Width="110" Height="28" HorizontalAlignment="Left" Margin="0,7,0,0" Click="tag_homeruns_clicked"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Name="SelectionInstructionsPanel"
                  Visibility="Collapsed"
                  Padding="8,6"
                  BorderBrush="{DynamicResource CED.Brush.InfoPanelBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CED.CornerRadius.Control}"
                  Background="{DynamicResource CED.Brush.InfoPanelBackground}">
            <TextBlock Name="SelectionInstructionsText"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Style="{DynamicResource CED.Text.Secondary}"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Name="InvalidContextOverlay"
            Grid.Row="1"
            Panel.ZIndex="100"
            Visibility="Collapsed"
            Background="{DynamicResource CED.Brush.WindowBackground}"
            Opacity="0.96">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{DynamicResource CED.Brush.InfoPanelBackground}"
                BorderBrush="{DynamicResource CED.Brush.InfoPanelBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CED.CornerRadius.Control}"
                Padding="24,18"
                MaxWidth="330">
          <TextBlock Name="InvalidContextMessageText"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource CED.Brush.PrimaryText}"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Button Name="RefreshTargetViewButton"
                Content="Refresh Target View"
                Style="{DynamicResource CED.Button.Base}"
                Width="132"
                Height="30"
                HorizontalAlignment="Left"
                Click="refresh_target_view_clicked"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="CloseButton" Content="Close" Style="{DynamicResource CED.Button.Base}" Width="100" Height="30" Margin="0,0,6,0" Click="close_clicked"/>
          <Button Name="RunButton" Content="Run Scheme" Style="{DynamicResource CED.Button.Apply}" Width="100" Height="30" Click="run_clicked"/>
        </StackPanel>
      </Grid>
      <TextBlock Name="StatusText"
                 Grid.Row="1"
                 Text="Choose a wiring scheme."
                 TextWrapping="Wrap"
                 TextAlignment="Right"
                 HorizontalAlignment="Right"
                 Style="{DynamicResource CED.Text.Secondary}"
                 Margin="0,4,0,0"/>
    </Grid>
  </Grid>
</Window>
