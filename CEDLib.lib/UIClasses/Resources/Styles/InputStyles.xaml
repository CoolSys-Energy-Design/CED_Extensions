<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="CED.Input.TextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.NeutralDark}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Background" Value="{DynamicResource CED.Brush.SearchBackground}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="InputBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="0"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              <Border x:Name="InputStateOverlay"
                      Background="Transparent"
                      CornerRadius="4"
                      IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                <Condition Binding="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
              <Setter TargetName="InputStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                <Condition Binding="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
              <Setter TargetName="InputStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Read-only display field. A read-only field must never draw MORE attention than
    an editable one, and that is easy to get wrong per-theme:

      CED.Brush.InputReadOnlyBorder aliases CED.Color.InfoPanelBorder, which is a
      *lighter* neutral than CED.Color.Border. Against a light surface lighter means
      lower contrast, so read-only correctly recedes (1.70 -> 1.52 against #FFFFFF).
      Against a dark surface lighter means HIGHER contrast, so read-only started
      shouting louder than editable (1.62 -> 1.99 against #1C2127).

    So the border now uses the same token as the editable field and the recession
    comes from Opacity plus the quieter background - a mechanism that points the
    same way in every theme. Opacity dims border, background and text together,
    so read-only always sits behind editable no matter what the theme defines.

    Do not set Opacity inline on individual read-only boxes; a local value beats
    this setter and removes the only cue that survives every theme.
  -->
  <Style x:Key="CED.Input.TextBox.ReadOnly" TargetType="TextBox" BasedOn="{StaticResource CED.Input.TextBox}">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource CED.Brush.InputReadOnlyBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.InputReadOnlyForeground}"/>
    <Setter Property="Opacity" Value="0.72"/>
  </Style>

  <Style x:Key="CED.Input.TextBox.FilePath" TargetType="TextBox" BasedOn="{StaticResource CED.Input.TextBox}">
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{DynamicResource CED.Brush.InputReadOnlyBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.InputReadOnlyBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource CED.Brush.InputReadOnlyForeground}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CED.Input.TextBox.PercentCompact" TargetType="TextBox" BasedOn="{StaticResource CED.Input.TextBox}">
    <Setter Property="Width" Value="58"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="CED.Input.CheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="CheckRoot" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CheckSurface"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CED.Brush.InputControlBackground}"
                    BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                    BorderThickness="1"
                    CornerRadius="3"/>
            <Path x:Name="CheckMark"
                  Grid.Column="0"
                  Width="9"
                  Height="8"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Margin="2,0,0,0"
                  Data="M1,4 L3.5,6.5 L8,1.5"
                  Stroke="{DynamicResource CED.Brush.InputControlCheckmark}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed"/>
            <ContentPresenter Grid.Column="1"
                              Margin="6,0,0,0"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"/>
            <Border x:Name="CheckStateOverlay"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    CornerRadius="3"
                    IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource CED.Brush.InputControlChecked}"/>
              <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource CED.Brush.InputControlChecked}"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource CED.Brush.InputControlChecked}"/>
              <Setter TargetName="CheckStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="CheckStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="CheckRoot" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.RadioButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="RadioRoot" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="RadioSurface"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CED.Brush.InputControlBackground}"
                    BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                    BorderThickness="1"
                    CornerRadius="7"/>
            <Ellipse x:Name="RadioDot"
                     Grid.Column="0"
                     Width="6"
                     Height="6"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Margin="4,0,0,0"
                     Fill="{DynamicResource CED.Brush.InputControlChecked}"
                     Visibility="Collapsed"/>
            <ContentPresenter Grid.Column="1"
                              Margin="6,0,0,0"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"/>
            <Border x:Name="RadioStateOverlay"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    CornerRadius="7"
                    IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="RadioSurface" Property="BorderBrush" Value="{DynamicResource CED.Brush.InputControlChecked}"/>
              <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="RadioSurface" Property="BorderBrush" Value="{DynamicResource CED.Brush.InputControlChecked}"/>
              <Setter TargetName="RadioStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="RadioStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="RadioRoot" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
    <Setter Property="Background" Value="{DynamicResource CED.Brush.ListItemBackground}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemHoverBackground}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CED.Input.ComboBox" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
    <Setter Property="Background" Value="{DynamicResource CED.Brush.SearchBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="MinHeight" Value="{DynamicResource CED.Size.ControlHeight}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{DynamicResource CED.Input.ComboBoxItem}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>

  <Style x:Key="CED.Input.ComboBox.ToggleOverlay" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.ComboBoxItem.Flat" TargetType="ComboBoxItem" BasedOn="{StaticResource CED.Input.ComboBoxItem}">
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource CED.Brush.CircuitItemHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}"/>
              <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource CED.Brush.CircuitItemSelectedBackground}"/>
              <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="CED.Input.ComboBox.Template.Flat" TargetType="ComboBox">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="ComboBorder"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="26"/>
          </Grid.ColumnDefinitions>
          <ContentPresenter Grid.Column="0"
                            Margin="8,0,4,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
          <Path Grid.Column="1"
                Data="{DynamicResource CED.Icon.ChevronDown}"
                Width="8"
                Height="6"
                Stretch="Uniform"
                Fill="{DynamicResource CED.Brush.IconMuted}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
          <ToggleButton x:Name="ComboToggle"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource CED.Input.ComboBox.ToggleOverlay}"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        ClickMode="Press"/>
          <Border x:Name="ComboStateOverlay"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  CornerRadius="6"
                  IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Popup Name="PART_Popup"
             AllowsTransparency="True"
             Focusable="False"
             IsOpen="{TemplateBinding IsDropDownOpen}"
             Placement="Bottom"
             PopupAnimation="Slide">
        <Border x:Name="DropDownBorder"
                Margin="0,2,0,0"
                Background="{DynamicResource CED.Brush.ListBackground}"
                BorderBrush="{DynamicResource CED.Brush.ListBorder}"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
          <ScrollViewer MaxHeight="300"
                        CanContentScroll="True"
                        VerticalScrollBarVisibility="Auto">
            <VirtualizingStackPanel IsItemsHost="True"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling"
                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
      </Trigger>
      <Trigger Property="IsDropDownOpen" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
      </Trigger>
      <Trigger SourceName="ComboToggle" Property="IsPressed" Value="True">
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
      </Trigger>
      <Trigger Property="HasItems" Value="False">
        <Setter TargetName="DropDownBorder" Property="MinHeight" Value="24"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="CED.Input.ComboBox.Flat" TargetType="ComboBox" BasedOn="{StaticResource CED.Input.ComboBox}">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CED.Input.ComboBoxItem.Flat}"/>
    <Setter Property="Template" Value="{StaticResource CED.Input.ComboBox.Template.Flat}"/>
  </Style>

  <Style x:Key="CED.Input.ComboBoxItem.Flat.Compact" TargetType="ComboBoxItem" BasedOn="{StaticResource CED.Input.ComboBoxItem.Flat}">
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="MinHeight" Value="20"/>
  </Style>

  <Style x:Key="CED.ScrollBar.Combo.Thumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource CED.Brush.IconMuted}"/>
    <Setter Property="Opacity" Value="0.58"/>
    <Setter Property="MinWidth" Value="7"/>
    <Setter Property="MinHeight" Value="7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbPill"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbPill" Property="Opacity" Value="0.74"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbPill" Property="Opacity" Value="0.90"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.ScrollBar.Combo.TrackButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="CED.ScrollBar.Combo.Template.Vertical" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track"
             IsDirectionReversed="True"
             HorizontalAlignment="Center"
             Width="7"
             Margin="0,2,0,2"
             Minimum="{TemplateBinding Minimum}"
             Maximum="{TemplateBinding Maximum}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
             ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource CED.ScrollBar.Combo.TrackButton}" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource CED.ScrollBar.Combo.Thumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource CED.ScrollBar.Combo.TrackButton}" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="CED.ScrollBar.Combo.Template.Horizontal" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track"
             IsDirectionReversed="False"
             VerticalAlignment="Center"
             Height="7"
             Margin="2,0,2,0"
             Minimum="{TemplateBinding Minimum}"
             Maximum="{TemplateBinding Maximum}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
             ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource CED.ScrollBar.Combo.TrackButton}" Command="ScrollBar.PageLeftCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource CED.ScrollBar.Combo.Thumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource CED.ScrollBar.Combo.TrackButton}" Command="ScrollBar.PageRightCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style x:Key="CED.ScrollBar.Combo" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.IconMuted}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="MinHeight" Value="8"/>
    <Setter Property="Template" Value="{StaticResource CED.ScrollBar.Combo.Template.Vertical}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource CED.ScrollBar.Combo.Template.Horizontal}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate x:Key="CED.Input.ComboBox.Template.Flat.Compact" TargetType="ComboBox">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="ComboBorder"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="26"/>
          </Grid.ColumnDefinitions>
          <ContentPresenter Grid.Column="0"
                            Margin="8,0,4,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
          <Path Grid.Column="1"
                Data="{DynamicResource CED.Icon.ChevronDown}"
                Width="8"
                Height="6"
                Stretch="Uniform"
                Fill="{DynamicResource CED.Brush.IconMuted}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
          <ToggleButton x:Name="ComboToggle"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource CED.Input.ComboBox.ToggleOverlay}"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        ClickMode="Press"/>
          <Border x:Name="ComboStateOverlay"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  CornerRadius="6"
                  IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Popup Name="PART_Popup"
             AllowsTransparency="True"
             Focusable="False"
             IsOpen="{TemplateBinding IsDropDownOpen}"
             Placement="Bottom"
             PopupAnimation="Slide">
        <Border x:Name="DropDownBorder"
                Margin="0,2,0,0"
                Background="{DynamicResource CED.Brush.ListBackground}"
                BorderBrush="{DynamicResource CED.Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
          <ScrollViewer MaxHeight="300"
                        CanContentScroll="True"
                        VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource CED.ScrollBar.Combo}"/>
            </ScrollViewer.Resources>
            <VirtualizingStackPanel IsItemsHost="True"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling"
                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
      </Trigger>
      <Trigger Property="IsDropDownOpen" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
      </Trigger>
      <Trigger SourceName="ComboToggle" Property="IsPressed" Value="True">
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
      </Trigger>
      <Trigger Property="HasItems" Value="False">
        <Setter TargetName="DropDownBorder" Property="MinHeight" Value="24"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="CED.Input.ComboBox.Template.Flat.Compact.Editable" TargetType="ComboBox">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="ComboBorder"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="26"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="PART_EditableTextBox"
                   Grid.Column="0"
                   Margin="8,0,4,0"
                   Background="Transparent"
                   BorderThickness="0"
                   VerticalAlignment="Center"
                   Foreground="{TemplateBinding Foreground}"
                   CaretBrush="{TemplateBinding Foreground}"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <Path Grid.Column="1"
                Data="{DynamicResource CED.Icon.ChevronDown}"
                Width="8"
                Height="6"
                Stretch="Uniform"
                Fill="{DynamicResource CED.Brush.IconMuted}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
          <ToggleButton x:Name="ComboToggle"
                        Grid.Column="1"
                        Style="{StaticResource CED.Input.ComboBox.ToggleOverlay}"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        ClickMode="Press"/>
          <Border x:Name="ComboStateOverlay"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  CornerRadius="6"
                  IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Popup Name="PART_Popup"
             AllowsTransparency="True"
             Focusable="False"
             IsOpen="{TemplateBinding IsDropDownOpen}"
             Placement="Bottom"
             PopupAnimation="Slide">
        <Border x:Name="DropDownBorder"
                Margin="0,2,0,0"
                Background="{DynamicResource CED.Brush.ListBackground}"
                BorderBrush="{DynamicResource CED.Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
          <ScrollViewer MaxHeight="300"
                        CanContentScroll="True"
                        VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource CED.ScrollBar.Combo}"/>
            </ScrollViewer.Resources>
            <VirtualizingStackPanel IsItemsHost="True"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling"
                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayHover}"/>
      </Trigger>
      <Trigger Property="IsDropDownOpen" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
      </Trigger>
      <Trigger SourceName="ComboToggle" Property="IsPressed" Value="True">
        <Setter TargetName="ComboStateOverlay" Property="Background" Value="{DynamicResource CED.Brush.ButtonStateOverlayPressed}"/>
      </Trigger>
      <Trigger Property="HasItems" Value="False">
        <Setter TargetName="DropDownBorder" Property="MinHeight" Value="24"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="CED.Input.ComboBox.Flat.Compact" TargetType="ComboBox" BasedOn="{StaticResource CED.Input.ComboBox.Flat}">
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CED.Input.ComboBoxItem.Flat.Compact}"/>
    <Setter Property="Template" Value="{StaticResource CED.Input.ComboBox.Template.Flat.Compact}"/>
  </Style>

  <Style x:Key="CED.Input.ComboBox.Flat.Compact.Editable"
         TargetType="ComboBox"
         BasedOn="{StaticResource CED.Input.ComboBox.Flat.Compact}">
    <Setter Property="IsEditable" Value="True"/>
    <Setter Property="IsTextSearchEnabled" Value="False"/>
    <Setter Property="StaysOpenOnEdit" Value="True"/>
    <Setter Property="Template" Value="{StaticResource CED.Input.ComboBox.Template.Flat.Compact.Editable}"/>
  </Style>

  <!--
    ===================================================================
    Horizontal sliders.  Three interchangeable looks share one anatomy:

      * a pill rail spans the full width behind the Track
      * the DecreaseRepeatButton paints the accent fill over that rail,
        overhanging to the right by half a thumb so the fill always ends
        under the knob's centre (that is what the negative right margin
        is for - do not "fix" it)
      * the IncreaseRepeatButton is transparent, so the rail shows
        through as the unfilled remainder
      * the Thumb is an uncoloured knob: input background, neutral
        border, accent border on hover and while dragging

    Every colour is a CED theme brush, so light / dark / alt themes
    follow with no per-theme overrides.

      CED.Input.Slider          Groove  - 6px rail, 16px disc  (default)
      CED.Input.Slider.Pill     Pill    - 4px rail, 10x20 pill
      CED.Input.Slider.Channel  Channel - 8px bordered channel, 18px disc

    To switch a slider's look, set Style to one of the three keys.
    ===================================================================
  -->

  <!-- Shared: unfilled remainder to the right of the knob. -->
  <Style x:Key="CED.Input.Slider.IncreaseButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <!-- Transparent, but hit-testable so clicking the empty track still pages. -->
          <Grid Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ A. Groove ============================ -->
  <Style x:Key="CED.Input.Slider.DecreaseButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="6" CornerRadius="3" Margin="0,0,-8,0" VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource CED.Brush.PrimaryBlue}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.Slider.Thumb" TargetType="Thumb">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbRoot" CornerRadius="8" SnapsToDevicePixels="True"
                  Background="{DynamicResource CED.Brush.InputControlBackground}"
                  BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                  BorderThickness="1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
              <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource CED.Brush.ButtonHoverBackground}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.Slider" TargetType="Slider">
    <Setter Property="Height" Value="20"/>
    <Setter Property="MinWidth" Value="90"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="SliderRoot" Background="Transparent">
            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource CED.Brush.InputControlBorder}"/>
            <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource CED.Input.Slider.DecreaseButton}"
                              Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource CED.Input.Slider.Thumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource CED.Input.Slider.IncreaseButton}"
                              Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="SliderRoot" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================= B. Pill ============================= -->
  <Style x:Key="CED.Input.Slider.Pill.DecreaseButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" Margin="0,0,-5,0" VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource CED.Brush.PrimaryBlue}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.Slider.Pill.Thumb" TargetType="Thumb">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbRoot" CornerRadius="5" SnapsToDevicePixels="True"
                  Background="{DynamicResource CED.Brush.InputControlBackground}"
                  BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                  BorderThickness="1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
              <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource CED.Brush.ButtonHoverBackground}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.Slider.Pill" TargetType="Slider">
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinWidth" Value="90"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="SliderRoot" Background="Transparent">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource CED.Brush.InputControlBorder}"/>
            <Track x:Name="PART_Track" Height="20" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource CED.Input.Slider.Pill.DecreaseButton}"
                              Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource CED.Input.Slider.Pill.Thumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource CED.Input.Slider.IncreaseButton}"
                              Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="SliderRoot" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =========================== C. Channel ============================ -->
  <Style x:Key="CED.Input.Slider.Channel.DecreaseButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <!-- Inset 1px on the left so the fill sits inside the channel's border. -->
            <Border Height="6" CornerRadius="3" Margin="1,0,-9,0" VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource CED.Brush.PrimaryBlue}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.Slider.Channel.Thumb" TargetType="Thumb">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbRoot" CornerRadius="9" SnapsToDevicePixels="True"
                  Background="{DynamicResource CED.Brush.InputControlBackground}"
                  BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                  BorderThickness="1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
              <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource CED.Brush.ButtonHoverBackground}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CED.Input.Slider.Channel" TargetType="Slider">
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinWidth" Value="90"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="SliderRoot" Background="Transparent">
            <!-- Same 1px border and radius language as the text boxes and combos. -->
            <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource CED.Brush.InfoPanelBackground}"
                    BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                    BorderThickness="1"/>
            <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource CED.Input.Slider.Channel.DecreaseButton}"
                              Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource CED.Input.Slider.Channel.Thumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource CED.Input.Slider.IncreaseButton}"
                              Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="SliderRoot" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- CheckBox variant used where a compact on/off toggle is clearer than a check mark. -->
  <Style x:Key="CED.Input.ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Border x:Name="Track"
                    Background="{DynamicResource CED.Brush.InputControlBackground}"
                    BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                    BorderThickness="1"
                    CornerRadius="11"/>
            <Border x:Name="Thumb"
                    Width="16"
                    Height="16"
                    Margin="3,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CED.Brush.SearchBackground}"
                    BorderBrush="{DynamicResource CED.Brush.InputControlBorder}"
                    BorderThickness="1"
                    CornerRadius="8"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource CED.Brush.AccentGreen}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CED.Brush.AccentGreen}"/>
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource CED.Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
