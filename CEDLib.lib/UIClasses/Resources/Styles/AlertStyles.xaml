<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="CED.Alert.Base" TargetType="Border">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CED.CornerRadius.Control}"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>

  <Style x:Key="CED.Alert.Info" TargetType="Border" BasedOn="{StaticResource CED.Alert.Base}">
    <Setter Property="Background" Value="{DynamicResource CED.Brush.AlertInfoBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AlertInfoBorder}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource CED.Brush.AlertInfoText}"/>
  </Style>
  <Style x:Key="CED.Alert.Warning" TargetType="Border" BasedOn="{StaticResource CED.Alert.Base}">
    <Setter Property="Background" Value="{DynamicResource CED.Brush.AlertWarningBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AlertWarningBorder}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource CED.Brush.AlertWarningText}"/>
  </Style>
  <Style x:Key="CED.Alert.Error" TargetType="Border" BasedOn="{StaticResource CED.Alert.Base}">
    <Setter Property="Background" Value="{DynamicResource CED.Brush.AlertErrorBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AlertErrorBorder}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource CED.Brush.AlertErrorText}"/>
  </Style>
  <Style x:Key="CED.Alert.Success" TargetType="Border" BasedOn="{StaticResource CED.Alert.Base}">
    <Setter Property="Background" Value="{DynamicResource CED.Brush.AlertSuccessBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CED.Brush.AlertSuccessBorder}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource CED.Brush.AlertSuccessText}"/>
  </Style>

  <Style x:Key="CED.Alert.Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.PrimaryText}"/>
  </Style>
  <Style x:Key="CED.Alert.Text.Info" TargetType="TextBlock" BasedOn="{StaticResource CED.Alert.Text}">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AlertInfoText}"/>
  </Style>
  <Style x:Key="CED.Alert.Text.Warning" TargetType="TextBlock" BasedOn="{StaticResource CED.Alert.Text}">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AlertWarningText}"/>
  </Style>
  <Style x:Key="CED.Alert.Text.Error" TargetType="TextBlock" BasedOn="{StaticResource CED.Alert.Text}">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AlertErrorText}"/>
  </Style>
  <Style x:Key="CED.Alert.Text.Success" TargetType="TextBlock" BasedOn="{StaticResource CED.Alert.Text}">
    <Setter Property="Foreground" Value="{DynamicResource CED.Brush.AlertSuccessText}"/>
  </Style>

  <Style x:Key="CED.Alert.Icon" TargetType="Path">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Fill" Value="{DynamicResource CED.Brush.PrimaryText}"/>
  </Style>
  <Style x:Key="CED.Alert.Icon.Info" TargetType="Path" BasedOn="{StaticResource CED.Alert.Icon}">
    <Setter Property="Fill" Value="{DynamicResource CED.Brush.AlertInfoText}"/>
  </Style>
  <Style x:Key="CED.Alert.Icon.Warning" TargetType="Path" BasedOn="{StaticResource CED.Alert.Icon}">
    <Setter Property="Fill" Value="{DynamicResource CED.Brush.AlertWarningText}"/>
  </Style>
  <Style x:Key="CED.Alert.Icon.Error" TargetType="Path" BasedOn="{StaticResource CED.Alert.Icon}">
    <Setter Property="Fill" Value="{DynamicResource CED.Brush.AlertErrorText}"/>
  </Style>
  <Style x:Key="CED.Alert.Icon.Success" TargetType="Path" BasedOn="{StaticResource CED.Alert.Icon}">
    <Setter Property="Fill" Value="{DynamicResource CED.Brush.AlertSuccessText}"/>
  </Style>
</ResourceDictionary>
