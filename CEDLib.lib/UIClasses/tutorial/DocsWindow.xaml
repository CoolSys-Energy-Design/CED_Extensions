<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Documentation"
        Width="960"
        Height="720"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CED.Brush.WindowBackground}"
        Foreground="{DynamicResource CED.Brush.PrimaryText}">

  <Grid Margin="{DynamicResource CED.Thickness.ContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Name="BackButton"
              Style="{DynamicResource CED.Button.IconSmall}"
              Height="24"
              MinWidth="34"
              Padding="6,0,6,0"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              IsEnabled="False"
              ToolTip="Back to the previous page">
        <TextBlock Text="&#8592;" FontSize="14" VerticalAlignment="Center"/>
      </Button>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <TextBlock Name="DocTitleText"
                   Text="Documentation"
                   Style="{DynamicResource CED.Text.Title}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Name="DocMetaText"
                   Text=""
                   Style="{DynamicResource CED.Text.Caption}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,1,0,0"/>
      </StackPanel>
      <Button Grid.Column="2"
              Name="TourButton"
              Style="{DynamicResource CED.Button.Base}"
              Content="Show me around"
              Height="26"
              MinWidth="128"
              VerticalAlignment="Center"
              ToolTip="Walk the tool with the highlights on"/>
    </Grid>

    <Border Grid.Row="1"
            Height="1"
            Background="{DynamicResource CED.Brush.SectionDivider}"
            Margin="0,10,0,10"/>

    <!-- contents + page -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" Name="ContentsColumn"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Name="ContentsHost"
              CornerRadius="{DynamicResource CED.CornerRadius.Panel}"
              Background="{DynamicResource CED.Brush.SurfaceAlt}"
              BorderBrush="{DynamicResource CED.Brush.Border}"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Text="On this page"
                     Style="{DynamicResource CED.Text.CaptionStrong}"
                     Margin="10,8,10,6"/>
          <ListBox Grid.Row="1"
                   Name="ContentsList"
                   BorderThickness="0"
                   Background="Transparent"
                   Margin="4,0,4,6"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              CornerRadius="{DynamicResource CED.CornerRadius.Panel}"
              Background="{DynamicResource CED.Brush.Surface}"
              BorderBrush="{DynamicResource CED.Brush.Border}"
              BorderThickness="1">
        <FlowDocumentScrollViewer Name="DocViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsSelectionEnabled="True"
                                  Padding="6"/>
      </Border>
    </Grid>

    <!-- footer -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Name="SourceText"
                 Text=""
                 Style="{DynamicResource CED.Text.Caption}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Name="OpenFileButton"
                Style="{DynamicResource CED.Button.Base}"
                Content="Open source"
                Width="104"
                Height="26"
                Margin="0,0,6,0"
                ToolTip="Open the markdown file outside Revit"/>
        <Button Name="CloseButton"
                Style="{DynamicResource CED.Button.Primary}"
                Content="Close"
                Width="92"
                Height="26"
                IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
