<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="480"
        SizeToContent="Height"
        MaxHeight="760"
        MinWidth="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CED.Brush.WindowBackground}"
        Foreground="{DynamicResource CED.Brush.PrimaryText}">

  <Grid Margin="{DynamicResource CED.Thickness.ContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Grid Grid.Row="0" Margin="0,0,0,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Name="FormTitleText"
                 Text="Settings"
                 Style="{DynamicResource CED.Text.Title}"
                 TextTrimming="CharacterEllipsis"/>
      <Button Grid.Column="1"
              Name="TutorialDocsButton"
              Style="{DynamicResource CED.Button.IconSmall}"
              Height="20"
              MinWidth="44"
              Padding="6,0,6,0"
              Margin="6,1,4,0"
              VerticalAlignment="Top"
              ToolTip="Open this tool's documentation">
        <TextBlock Text="Docs" FontSize="11" VerticalAlignment="Center"/>
      </Button>
      <Button Grid.Column="2"
              Name="TutorialHelpButton"
              Style="{DynamicResource CED.Button.IconSmall}"
              Width="20"
              Height="20"
              Padding="0"
              Margin="0,1,0,0"
              VerticalAlignment="Top"
              ToolTip="Show me around, or open the documentation">
        <TextBlock Text="?" FontSize="12" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
    </Grid>

    <TextBlock Grid.Row="1"
               Name="FormSubtitleText"
               Style="{DynamicResource CED.Text.Secondary}"
               TextWrapping="Wrap"
               Margin="0,0,0,10"
               Visibility="Collapsed"/>

    <!-- fields are built in code into this host -->
    <ScrollViewer Grid.Row="2"
                  Name="FieldScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="FieldHost" Orientation="Vertical"/>
    </ScrollViewer>

    <Border Grid.Row="3"
            Name="ValidationHost"
            Margin="0,8,0,0"
            CornerRadius="4"
            Background="{DynamicResource CED.Brush.StatusWarningBackground}"
            BorderBrush="{DynamicResource CED.Brush.BadgeWarningBorder}"
            BorderThickness="1"
            Padding="8,5,8,5"
            Visibility="Collapsed">
      <TextBlock Name="ValidationText"
                 Style="{DynamicResource CED.Text.Secondary}"
                 TextWrapping="Wrap"/>
    </Border>

    <!-- footer -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Name="ResetButton"
              Style="{DynamicResource CED.Button.Base}"
              Content="Reset"
              Width="72"
              Height="26"
              HorizontalAlignment="Left"
              ToolTip="Put every field back to its default"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Name="CancelButton"
                Style="{DynamicResource CED.Button.Base}"
                Content="Cancel"
                Width="82"
                Height="26"
                Margin="0,0,6,0"
                IsCancel="True"/>
        <Button Name="OkButton"
                Style="{DynamicResource CED.Button.Primary}"
                Content="Continue"
                Width="102"
                Height="26"
                IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
