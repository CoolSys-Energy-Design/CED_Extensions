<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CED Documentation"
        Width="1180" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CED.Brush.WindowBackground}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="12" Background="{DynamicResource CED.Brush.Surface}"
            BorderBrush="{DynamicResource CED.Brush.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="BackButton" Content="←" ToolTip="Back" Width="34" Height="24"
                  Style="{DynamicResource CED.Button.IconSmall}" />
          <Button x:Name="ForwardButton" Content="→" ToolTip="Forward" Width="34" Height="24" Margin="4,0,0,0"
                  Style="{DynamicResource CED.Button.IconSmall}" />
          <Button x:Name="HomeButton" ToolTip="Home and clear filters" Width="34" Height="24" Margin="8,0,8,0"
                  Style="{DynamicResource CED.Button.IconSmall}">
            <Path Data="{DynamicResource CED.Icon.Home}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="16" Height="16" Stretch="Uniform" />
          </Button>
        </StackPanel>
        <Grid Grid.Column="1" Height="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.ColumnSpan="3" Style="{DynamicResource CED.SearchBox.Chrome}" />
          <Path Grid.Column="0" Data="{DynamicResource CED.Icon.Search}"
                Fill="{DynamicResource CED.Brush.IconMuted}" Width="15" Height="15"
                Margin="9,0,5,0" VerticalAlignment="Center" Stretch="Uniform" />
          <TextBox x:Name="SearchBox" Grid.Column="1" Height="24"
                   ToolTip="Search titles, headings, keywords, ribbon paths, and page text"
                   Style="{DynamicResource CED.SearchBox.Input}" />
          <TextBlock x:Name="SearchPlaceholderText" Grid.Column="1" Text="Search documentation"
                     Style="{DynamicResource CED.SearchBox.Placeholder}" Margin="6,0,0,0" />
          <Button x:Name="ClearSearchButton" Grid.Column="2" Height="24" Width="24"
                  Style="{DynamicResource CED.SearchBox.ClearButton}"
                  ToolTip="Clear search" Visibility="Collapsed">
            <Path Data="{DynamicResource CED.Icon.Close}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="10" Height="10" Stretch="Uniform" />
          </Button>
        </Grid>
        <ComboBox x:Name="ExtensionFilter" Grid.Column="3" Height="24" MinWidth="150"
                  Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" />
        <ComboBox x:Name="RibbonFilter" Grid.Column="5" Height="24" MinWidth="220"
                  Style="{DynamicResource CED.Input.ComboBox.Flat.Compact}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="250" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource CED.Brush.ListBackground}"
              BorderBrush="{DynamicResource CED.Brush.Border}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="12,8,10,6">
            <TextBlock x:Name="ResultsSummary" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Style="{DynamicResource CED.Text.CaptionStrong}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <StackPanel x:Name="TreeActionsPanel" Orientation="Horizontal" Visibility="Collapsed"
                          Margin="0,0,10,0">
                <Button x:Name="CollapseTreeButton" Content="−" Width="25" Height="24"
                        ToolTip="Collapse all" Style="{DynamicResource CED.Button.IconSmall}" />
                <Button x:Name="ExpandTreeButton" Content="+" Width="25" Height="24" Margin="3,0,0,0"
                        ToolTip="Expand all" Style="{DynamicResource CED.Button.IconSmall}" />
              </StackPanel>
              <RadioButton x:Name="ListModeButton" Content="List" GroupName="ResultMode" IsChecked="True"
                           Margin="0,0,10,0" Style="{DynamicResource CED.Input.RadioButton}" />
              <RadioButton x:Name="TreeModeButton" Content="Tree" GroupName="ResultMode"
                           Style="{DynamicResource CED.Input.RadioButton}" />
            </StackPanel>
          </DockPanel>
          <ListBox x:Name="ResultsList" Grid.Row="1"
                   Style="{DynamicResource CED.ListBox}"
                   ItemContainerStyle="{DynamicResource CED.ListBoxItem}"
                   BorderThickness="0" Padding="5"
                   Background="{DynamicResource CED.Brush.ListBackground}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,1,2,4">
                  <ContentPresenter Content="{Binding TitleDisplay}" />
                  <ContentPresenter Content="{Binding ExtensionDisplay}" Margin="0,3,0,0" />
                  <ContentPresenter Content="{Binding RibbonPathDisplay}" Margin="0,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TreeView x:Name="ResultsTree" Grid.Row="1" Visibility="Collapsed"
                    Style="{DynamicResource CED.Documentation.Tree}" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="{DynamicResource CED.Brush.SectionDivider}" />
      <FlowDocumentScrollViewer x:Name="DocumentViewer" Grid.Column="2"
                                Style="{DynamicResource CED.Documentation.Reader}" />
    </Grid>

    <Border Grid.Row="2" Padding="10,6" Background="{DynamicResource CED.Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource CED.Brush.Border}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                   Foreground="{DynamicResource CED.Brush.SecondaryText}" TextWrapping="Wrap" />
        <TextBlock x:Name="LocationText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                   Foreground="{DynamicResource CED.Brush.SecondaryText}" />
      </DockPanel>
    </Border>

    <Border x:Name="ErrorOverlay" Grid.RowSpan="3" Visibility="Collapsed"
            Background="#99000000" Padding="40">
      <Border Width="520" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource CED.Brush.Surface}"
              BorderBrush="{DynamicResource CED.Brush.AlertErrorBorder}" BorderThickness="1"
              CornerRadius="6" Padding="22">
        <StackPanel>
          <TextBlock x:Name="ErrorTitle" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource CED.Brush.HeadingText}" />
          <TextBlock x:Name="ErrorMessage" Margin="0,10,0,18" TextWrapping="Wrap"
                     Foreground="{DynamicResource CED.Brush.PrimaryText}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="Retry" Margin="0,0,8,0"
                    Style="{DynamicResource CED.Button.Primary}" />
            <Button x:Name="CloseErrorButton" Content="Close"
                    Style="{DynamicResource CED.Button.Base}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
